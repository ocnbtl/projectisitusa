  "components": [
    {
      "name": "Botanical editorial heading",
      "kind": "custom",
      "refersTo": "editorial-heading",
      "description": "About opening typography; uses the app-loaded display face with its declared fallback. Hosted preview rendering and production font loading were verified; see the botanical-email verification report for the tested scope.",
      "html": "<h1 class=\"ds-editorial-heading\">Local knowledge.<br>A wider understanding.</h1>",
      "css": ".ds-editorial-heading{margin:0 0 40px;color:var(--foreground,#173c38);font-family:var(--font-display,\"ISITUSA Field Display\",Georgia,serif);font-size:clamp(36px,3.5vw,64px);font-weight:800;font-synthesis:none;line-height:1.08;letter-spacing:-.015em;text-wrap:balance}@media(max-width:700px){.ds-editorial-heading{font-size:clamp(36px,9vw,46px);margin-bottom:28px}}"
    },
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Support action with the existing hover, focus, and disabled treatments.",
      "html": "<button class=\"ds-primary\" type=\"button\">Support the work</button>",
      "css": ".ds-primary{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:46px;padding:11px 16px;border:0;background:var(--accent,#14675f);color:var(--background,#edf2ef);border-radius:9px;font-family:var(--font-body,\"Avenir Next\",\"Segoe UI\",sans-serif);font-size:14px;font-weight:600;cursor:pointer;transition:background 160ms}.ds-primary:hover{background:var(--accent-strong,#07574e)}.ds-primary:focus-visible{outline:2px solid var(--ring,#19776b);outline-offset:3px;outline-offset:4px}.ds-primary:disabled{opacity:.6;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Participation secondary action retains paper, border, and sans typography; no separate hover fill is defined in source.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Review choices</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:12px 18px;background:var(--surface-strong,#fbfdfb);color:var(--foreground,#173c38);border:1px solid var(--border,#cbd8d1);border-radius:8px;font-family:var(--font-body,\"Avenir Next\",\"Segoe UI\",sans-serif);font-size:14px;font-weight:600;cursor:pointer;transition:color .16s,background-color .16s,border-color .16s}.ds-secondary:hover{background:var(--surface-strong,#fbfdfb)}.ds-secondary:focus-visible{outline:2px solid var(--ring,#19776b);outline-offset:3px}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Participation field",
      "kind": "input",
      "refersTo": "input",
      "description": "Existing labeled form field, preserving readable interface type and focus ring.",
      "html": "<label class=\"ds-field\">Email address<input class=\"ds-input\" type=\"email\" placeholder=\"you@example.com\"></label>",
      "css": ".ds-field{display:grid;gap:8px;color:var(--foreground,#173c38);font-family:var(--font-body,\"Avenir Next\",\"Segoe UI\",sans-serif);font-size:14px;font-weight:550}.ds-input{width:100%;min-width:0;min-height:46px;padding:12px 14px;border:1px solid var(--border,#cbd8d1);border-radius:8px;background:var(--surface-strong,#fbfdfb);color:var(--foreground,#173c38);font:inherit}.ds-input::placeholder{color:var(--muted,#526863);opacity:1}.ds-input:focus-visible{outline:2px solid var(--ring,#19776b);outline-offset:3px}"
    },
    {
      "name": "Removable participation tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Compact selected tag with the existing 44px removal control.",
      "html": "<span class=\"ds-tag\">County updates<button type=\"button\" aria-label=\"Remove county updates\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"m18 6-12 12M6 6l12 12\"/></svg></button></span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;gap:10px;padding:2px 2px 2px 12px;border:1px solid var(--border,#cbd8d1);border-radius:7px;background:var(--surface-strong,#fbfdfb);color:var(--foreground,#173c38);font-family:var(--font-body,\"Avenir Next\",\"Segoe UI\",sans-serif);font-size:13px;overflow-wrap:anywhere}.ds-tag button{display:grid;place-items:center;min-width:44px;min-height:44px;border:0;border-radius:6px;background:transparent;color:inherit;cursor:pointer;transition:color .16s,background-color .16s,border-color .16s}.ds-tag button:hover{background:var(--background,#edf2ef)}.ds-tag button:focus-visible{outline:2px solid var(--ring,#19776b);outline-offset:3px}"
    },
    {
      "name": "Contribution panel",
      "kind": "card",
      "refersTo": "contribution-panel",
      "description": "Opaque bordered support panel; payment-option heading remains sans.",
      "html": "<section class=\"ds-contribution\"><h3>One-time contribution</h3><p>Support the work.</p></section>",
      "css": ".ds-contribution{min-width:0;padding:24px;border:1px solid var(--border,#cbd8d1);border-radius:14px;background:var(--surface-strong,#fbfdfb);color:var(--foreground,#173c38);font-family:var(--font-body,\"Avenir Next\",\"Segoe UI\",sans-serif)}.ds-contribution h3{margin:0;display:flex;align-items:center;gap:10px;font-size:20px;font-weight:550;line-height:1.3;letter-spacing:-.02em}.ds-contribution p{font-size:13px;color:var(--muted,#526863);line-height:1.7;margin:12px 0 20px}@media(max-width:600px){.ds-contribution{padding:20px}}"
    },
    {
      "name": "Primary navigation link",
      "kind": "nav",
      "refersTo": "navigation-link",
      "description": "Static current-page state from the existing navigation. Application code measures and moves the active indicator.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example navigation\"><span class=\"ds-nav-indicator\" aria-hidden=\"true\"></span><a href=\"/about\" aria-current=\"page\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 16v-4M12 8h.01\"/></svg><span>About</span></a></nav>",
      "css": ".ds-nav{position:relative;display:inline-flex;font-family:var(--font-body,\"Avenir Next\",\"Segoe UI\",sans-serif);color:var(--foreground,#173c38)}.ds-nav a{position:relative;z-index:1;display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:10px 12px;min-height:44px;border-radius:9px;color:var(--accent-strong,#07574e);font-size:13px;white-space:nowrap;text-decoration:none;transition:color 180ms ease}.ds-nav a:hover{background:transparent;color:var(--accent-strong,#07574e)}.ds-nav a:focus-visible{outline:2px solid var(--ring,#19776b);outline-offset:3px}.ds-nav-indicator{position:absolute;inset:0;border-radius:10px;background:color-mix(in srgb,var(--accent,#14675f) 11%,transparent);pointer-events:none;transition:transform 420ms cubic-bezier(.16,1,.3,1),width 420ms cubic-bezier(.16,1,.3,1),opacity 180ms}@media(max-width:700px){.ds-nav a{flex-direction:column;gap:3px;padding:3px 5px;font-size:11px;min-width:44px;min-height:46px}.ds-nav-indicator{border-radius:8px}}@media(prefers-reduced-motion:reduce){.ds-nav-indicator{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "An open field atlas.",
    "overview": "The map is the workspace. Search, filters, and geographic navigation float above it; evidence is read on an opaque surface. Restrained environmental color and precise cartographic detail support the existing atlas.\n\nBotanical display lettering unifies the ISITUSA acronym, full name, and public editorial headings. Generous curves end in crisp, tapered tips, following the user's NYBG-inspired direction while preserving the established bird/leaf/fungi emblem. Neutral sans text carries navigation, scientific data, forms, and body copy.",
    "keyCharacteristics": [
      "Botanical expression in the identity and editorial display type.",
