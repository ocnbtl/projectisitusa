{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/aphis-honey-bee-survey-parameters.schema.json",
  "title": "APHIS Honey Bee explicit-survey pilot parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stateCode",
    "candidateLimit",
    "candidatePairs",
    "downloadPageUrl",
    "generatedHeaderExact",
    "coverageHeaderExact",
    "surveyDateRange",
    "metricColumn",
    "targetSpeciesId",
    "targetScientificName",
    "zeroValue",
    "expectedSurveyRows",
    "maxCsvBytes"
  ],
  "properties": {
    "stateCode": { "const": "AL" },
    "candidateLimit": { "const": 1 },
    "candidatePairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "const": "01025:varroa-destructor" }
    },
    "downloadPageUrl": {
      "const": "https://www.usbeedata.org/state_reports/public_download/"
    },
    "generatedHeaderExact": {
      "const": "File generated from usbeedata.org database on 2026-06-05 13:15:49.160078+00:00"
    },
    "coverageHeaderExact": {
      "const": "\"Includes data with a collection date up to Dec 31, 2025\""
    },
    "surveyDateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "const": "2025-05-01" },
        "end": { "const": "2025-05-31" }
      }
    },
    "metricColumn": { "const": "varroa_per_100_bees" },
    "targetSpeciesId": { "const": "varroa-destructor" },
    "targetScientificName": { "const": "Varroa destructor" },
    "zeroValue": { "const": 0 },
    "expectedSurveyRows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "countyFips",
          "countyName",
          "sampleYear",
          "sampleMonth",
          "sampleMonthName",
          "varroaPer100Bees"
        ],
        "properties": {
          "countyFips": { "const": "01025" },
          "countyName": { "const": "Clarke" },
          "sampleYear": { "const": 2025 },
          "sampleMonth": { "const": 5 },
          "sampleMonthName": { "const": "May" },
          "varroaPer100Bees": { "const": 0 }
        }
      }
    },
    "maxCsvBytes": { "const": 5242880 }
  }
}
