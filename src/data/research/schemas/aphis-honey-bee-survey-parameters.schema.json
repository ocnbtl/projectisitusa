{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/aphis-honey-bee-survey-parameters.schema.json",
  "title": "APHIS Honey Bee legacy explicit-zero pilot or retained positive survey parameters",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stateCode",
        "candidateLimit",
        "candidatePairs",
        "downloadPageUrl",
        "generatedHeaderExact",
        "coverageHeaderExact",
        "surveyDateRange",
        "metricColumn",
        "targetSpeciesId",
        "targetScientificName",
        "zeroValue",
        "expectedSurveyRows",
        "maxCsvBytes"
      ],
      "properties": {
        "stateCode": {
          "const": "AL"
        },
        "candidateLimit": {
          "const": 1
        },
        "candidatePairs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "01025:varroa-destructor"
          }
        },
        "downloadPageUrl": {
          "const": "https://www.usbeedata.org/state_reports/public_download/"
        },
        "generatedHeaderExact": {
          "const": "File generated from usbeedata.org database on 2026-06-05 13:15:49.160078+00:00"
        },
        "coverageHeaderExact": {
          "const": "\"Includes data with a collection date up to Dec 31, 2025\""
        },
        "surveyDateRange": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "const": "2025-05-01"
            },
            "end": {
              "const": "2025-05-31"
            }
          }
        },
        "metricColumn": {
          "const": "varroa_per_100_bees"
        },
        "targetSpeciesId": {
          "const": "varroa-destructor"
        },
        "targetScientificName": {
          "const": "Varroa destructor"
        },
        "zeroValue": {
          "const": 0
        },
        "expectedSurveyRows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "countyFips",
              "countyName",
              "sampleYear",
              "sampleMonth",
              "sampleMonthName",
              "varroaPer100Bees"
            ],
            "properties": {
              "countyFips": {
                "const": "01025"
              },
              "countyName": {
                "const": "Clarke"
              },
              "sampleYear": {
                "const": 2025
              },
              "sampleMonth": {
                "const": 5
              },
              "sampleMonthName": {
                "const": "May"
              },
              "varroaPer100Bees": {
                "const": 0
              }
            }
          }
        },
        "maxCsvBytes": {
          "const": 5242880
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "stateCode",
        "methodReviewSha256",
        "candidatePairs",
        "candidateLimit"
      ],
      "properties": {
        "mode": {
          "const": "retained-positive-survey"
        },
        "stateCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "methodReviewSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidateLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "candidatePairs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{5}:varroa-destructor$"
          }
        }
      }
    }
  ]
}
