{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/usfs-afpe-archive-parameters.schema.json",
  "title": "USFS AFPE versioned national archive replay parameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["stateCode", "mode", "nationalAcquisitionId", "nationalAcquisitionReceiptSha256", "archiveVersion", "mappingVersion", "mappingSha256", "candidateLimit", "candidatePairs", "sourceDataLastUpdated"],
  "properties": {
    "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "mode": { "const": "national-archive-replay" },
    "nationalAcquisitionId": { "type": "string", "minLength": 1 },
    "nationalAcquisitionReceiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "archiveVersion": { "const": "1.0" },
    "mappingVersion": { "const": "2026-07-25.1" },
    "mappingSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateLimit": { "type": "integer", "minimum": 1, "maximum": 5000 },
    "candidatePairs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{5}:[a-z0-9-]+$" }, "minItems": 1, "maxItems": 5000, "uniqueItems": true },
    "sourceDataLastUpdated": { "const": "2023-04" }
  }
}
