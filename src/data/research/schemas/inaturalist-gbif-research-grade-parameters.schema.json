{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/inaturalist-gbif-research-grade-parameters.schema.json",
  "title": "iNaturalist weekly GBIF Research Grade adapter parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stateCode",
    "stateProvince",
    "candidateLimit",
    "candidatePairs",
    "basisOfRecord",
    "occurrenceStatus",
    "minimumMatchConfidence",
    "pageLimit",
    "datasetKey",
    "expectedCrawlId",
    "expectedLastParsed",
    "maximumCoordinateUncertaintyMeters",
    "allowedLicenses"
  ],
  "properties": {
    "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "stateProvince": { "type": "string", "minLength": 1 },
    "candidateLimit": { "type": "integer", "minimum": 1, "maximum": 5000 },
    "candidatePairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{5}:[a-z0-9-]+$" }
    },
    "basisOfRecord": { "const": "HUMAN_OBSERVATION" },
    "occurrenceStatus": { "const": "PRESENT" },
    "minimumMatchConfidence": { "type": "integer", "minimum": 95, "maximum": 100 },
    "pageLimit": { "type": "integer", "minimum": 1, "maximum": 300 },
    "datasetKey": { "const": "50c9509d-22c7-4a22-a47d-8c48425ef4a7" },
    "expectedCrawlId": { "type": "integer", "minimum": 1 },
    "expectedLastParsed": { "type": "string", "format": "date-time" },
    "maximumCoordinateUncertaintyMeters": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "allowedLicenses": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "http://creativecommons.org/publicdomain/zero/1.0/legalcode",
          "http://creativecommons.org/licenses/by/4.0/legalcode",
          "http://creativecommons.org/licenses/by-nc/4.0/legalcode"
        ]
      }
    }
  }
}
