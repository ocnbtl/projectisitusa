{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/research-projection.schema.json",
  "title": "Project Isitusa static research projection",
  "oneOf": [
    { "$ref": "#/$defs/stateProjection" },
    { "$ref": "#/$defs/countyProjection" }
  ],
  "$defs": {
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "projectionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationMode",
        "speciesMode",
        "certificationScope",
        "applicabilityPath",
        "applicabilityAsOf",
        "catalogSpeciesCount",
        "stateSpeciesDenominator",
        "applicableSpeciesCount",
        "notApplicableSpeciesCount",
        "unknownSpeciesCount",
        "blockedSpeciesCount",
        "explicitApplicabilityDecisionCount",
        "derivedApplicableSpeciesCount",
        "resolvedStateSpeciesDecisionCount",
        "boundedAcquisitionSpeciesCount",
        "defaultApplicability",
        "fullCatalogApplicabilityComplete",
        "fullCatalogResearchAccounted",
        "undeterminedSpeciesPolicy",
        "compatibilityPublication",
        "protocolModel"
      ],
      "properties": {
        "publicationMode": { "enum": ["authoritative", "research-only"] },
        "speciesMode": { "enum": ["catalog-all", "sparse-default"] },
        "certificationScope": { "enum": ["state-baseline", "bounded-pilot"] },
        "applicabilityPath": { "type": "string", "minLength": 1 },
        "applicabilityAsOf": { "type": "string", "format": "date" },
        "catalogSpeciesCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "stateSpeciesDenominator": { "$ref": "#/$defs/nonnegativeInteger" },
        "applicableSpeciesCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "notApplicableSpeciesCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "unknownSpeciesCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "blockedSpeciesCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "explicitApplicabilityDecisionCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "derivedApplicableSpeciesCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "resolvedStateSpeciesDecisionCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "boundedAcquisitionSpeciesCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "defaultApplicability": { "const": "unknown" },
        "fullCatalogApplicabilityComplete": { "type": "boolean" },
        "fullCatalogResearchAccounted": { "type": "boolean" },
        "undeterminedSpeciesPolicy": { "const": "included-as-unknown" },
        "compatibilityPublication": { "type": "boolean" },
        "protocolModel": { "enum": ["explicit-source-species-legacy-migration", "explicit-source-species-active"] }
      }
    },
    "stateSpeciesResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "defaultStatus",
        "denominator",
        "countyEquivalentCount",
        "applicabilityDecisionCounts",
        "derivedApplicableSpeciesCount",
        "counts",
        "fullyAccountedSpeciesCount",
        "partiallyAccountedSpeciesCount",
        "untouchedSpeciesCount",
        "fullCatalogResearchAccounted",
        "overrides"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "defaultStatus": { "const": "not-researched" },
        "denominator": { "$ref": "#/$defs/nonnegativeInteger" },
        "countyEquivalentCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "applicabilityDecisionCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicable", "not-applicable", "unknown", "blocked"],
          "properties": {
            "applicable": { "$ref": "#/$defs/nonnegativeInteger" },
            "not-applicable": { "$ref": "#/$defs/nonnegativeInteger" },
            "unknown": { "$ref": "#/$defs/nonnegativeInteger" },
            "blocked": { "$ref": "#/$defs/nonnegativeInteger" }
          }
        },
        "derivedApplicableSpeciesCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicable",
            "not-applicable",
            "researched-unresolved",
            "researched-blocked",
            "partially-researched",
            "not-researched",
            "blocked"
          ],
          "properties": {
            "applicable": { "$ref": "#/$defs/nonnegativeInteger" },
            "not-applicable": { "$ref": "#/$defs/nonnegativeInteger" },
            "researched-unresolved": { "$ref": "#/$defs/nonnegativeInteger" },
            "researched-blocked": { "$ref": "#/$defs/nonnegativeInteger" },
            "partially-researched": { "$ref": "#/$defs/nonnegativeInteger" },
            "not-researched": { "$ref": "#/$defs/nonnegativeInteger" },
            "blocked": { "$ref": "#/$defs/nonnegativeInteger" }
          }
        },
        "fullyAccountedSpeciesCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "partiallyAccountedSpeciesCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "untouchedSpeciesCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "fullCatalogResearchAccounted": { "type": "boolean" },
        "overrides": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "speciesId",
              "status",
              "applicabilityStatus",
              "applicabilityBasis",
              "researchedCountyCount",
              "blockedCountyCount",
              "accountedCountyCount",
              "notResearchedCountyCount"
            ],
            "properties": {
              "speciesId": { "type": "string", "minLength": 1 },
              "status": {
                "enum": [
                  "applicable",
                  "not-applicable",
                  "researched-unresolved",
                  "researched-blocked",
                  "partially-researched",
                  "not-researched",
                  "blocked"
                ]
              },
              "applicabilityStatus": {
                "enum": ["applicable", "not-applicable", "unknown", "blocked"]
              },
              "applicabilityBasis": {
                "enum": ["explicit", "accepted-reviewed-presence", "unresolved"]
              },
              "researchedCountyCount": { "$ref": "#/$defs/nonnegativeInteger" },
              "blockedCountyCount": { "$ref": "#/$defs/nonnegativeInteger" },
              "accountedCountyCount": { "$ref": "#/$defs/nonnegativeInteger" },
              "notResearchedCountyCount": { "$ref": "#/$defs/nonnegativeInteger" }
            }
          }
        }
      }
    },
    "boundedStatusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speciesCount",
        "totalPairs",
        "verifiedPresent",
        "verifiedAbsent",
        "notDetected",
        "researchedUnresolved",
        "notResearched",
        "researchCoveragePercent",
        "explicitOutcomePairs",
        "explicitOutcomeCoveragePercent"
      ],
      "properties": {
        "speciesCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "totalPairs": { "$ref": "#/$defs/nonnegativeInteger" },
        "verifiedPresent": { "$ref": "#/$defs/nonnegativeInteger" },
        "verifiedAbsent": { "$ref": "#/$defs/nonnegativeInteger" },
        "notDetected": { "$ref": "#/$defs/nonnegativeInteger" },
        "researchedUnresolved": { "$ref": "#/$defs/nonnegativeInteger" },
        "notResearched": { "$ref": "#/$defs/nonnegativeInteger" },
        "researchCoveragePercent": { "$ref": "#/$defs/percentage" },
        "explicitOutcomePairs": { "$ref": "#/$defs/nonnegativeInteger" },
        "explicitOutcomeCoveragePercent": { "$ref": "#/$defs/percentage" }
      }
    },
    "statusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogSpeciesCount",
        "fullCountySpeciesDenominator",
        "resolvablePairs",
        "notApplicablePairs",
        "blockedPairs",
        "verifiedPresent",
        "verifiedAbsent",
        "notDetected",
        "researchedUnresolved",
        "notResearched",
        "researchCoveragePercent",
        "explicitOutcomePairs",
        "explicitOutcomeCoveragePercent",
        "boundedAcquisition"
      ],
      "properties": {
        "catalogSpeciesCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "fullCountySpeciesDenominator": { "$ref": "#/$defs/nonnegativeInteger" },
        "resolvablePairs": { "$ref": "#/$defs/nonnegativeInteger" },
        "notApplicablePairs": { "$ref": "#/$defs/nonnegativeInteger" },
        "blockedPairs": { "$ref": "#/$defs/nonnegativeInteger" },
        "verifiedPresent": { "$ref": "#/$defs/nonnegativeInteger" },
        "verifiedAbsent": { "$ref": "#/$defs/nonnegativeInteger" },
        "notDetected": { "$ref": "#/$defs/nonnegativeInteger" },
        "researchedUnresolved": { "$ref": "#/$defs/nonnegativeInteger" },
        "notResearched": { "$ref": "#/$defs/nonnegativeInteger" },
        "researchCoveragePercent": { "$ref": "#/$defs/percentage" },
        "explicitOutcomePairs": { "$ref": "#/$defs/nonnegativeInteger" },
        "explicitOutcomeCoveragePercent": { "$ref": "#/$defs/percentage" },
        "boundedAcquisition": { "$ref": "#/$defs/boundedStatusCounts" }
      }
    },
    "stateTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speciesCount",
        "countyCount",
        "totalPairs",
        "resolvablePairCount",
        "notApplicablePairCount",
        "blockedPairCount",
        "verifiedPresent",
        "verifiedAbsent",
        "notDetected",
        "researchedUnresolved",
        "notResearched",
        "determinationCoveragePercent",
        "researchCoveragePercent",
        "explicitOutcomePairCount",
        "explicitOutcomeCoveragePercent",
        "conflictCount",
        "evidenceRecordCount",
        "bootstrapEvidenceRecordCount",
        "runEvidenceRecordCount",
        "rejectionRecordCount",
        "researchRunCount",
        "boundedAcquisition"
      ],
      "properties": {
        "speciesCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "countyCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "totalPairs": { "$ref": "#/$defs/nonnegativeInteger" },
        "resolvablePairCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "notApplicablePairCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "blockedPairCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "verifiedPresent": { "$ref": "#/$defs/nonnegativeInteger" },
        "verifiedAbsent": { "$ref": "#/$defs/nonnegativeInteger" },
        "notDetected": { "$ref": "#/$defs/nonnegativeInteger" },
        "researchedUnresolved": { "$ref": "#/$defs/nonnegativeInteger" },
        "notResearched": { "$ref": "#/$defs/nonnegativeInteger" },
        "determinationCoveragePercent": { "$ref": "#/$defs/percentage" },
        "researchCoveragePercent": { "$ref": "#/$defs/percentage" },
        "explicitOutcomePairCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "explicitOutcomeCoveragePercent": { "$ref": "#/$defs/percentage" },
        "conflictCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "evidenceRecordCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "bootstrapEvidenceRecordCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "runEvidenceRecordCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "rejectionRecordCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "researchRunCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "boundedAcquisition": { "$ref": "#/$defs/boundedStatusCounts" }
      }
    },
    "countySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "countyFips",
        "name",
        "catalogSpeciesCount",
        "fullCountySpeciesDenominator",
        "resolvablePairs",
        "notApplicablePairs",
        "blockedPairs",
        "verifiedPresent",
        "verifiedAbsent",
        "notDetected",
        "researchedUnresolved",
        "notResearched",
        "researchCoveragePercent",
        "explicitOutcomePairs",
        "explicitOutcomeCoveragePercent",
        "boundedAcquisition"
      ],
      "properties": {
        "countyFips": { "type": "string", "pattern": "^[0-9]{5}$" },
        "name": { "type": "string", "minLength": 1 },
        "catalogSpeciesCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "fullCountySpeciesDenominator": { "$ref": "#/$defs/nonnegativeInteger" },
        "resolvablePairs": { "$ref": "#/$defs/nonnegativeInteger" },
        "notApplicablePairs": { "$ref": "#/$defs/nonnegativeInteger" },
        "blockedPairs": { "$ref": "#/$defs/nonnegativeInteger" },
        "verifiedPresent": { "$ref": "#/$defs/nonnegativeInteger" },
        "verifiedAbsent": { "$ref": "#/$defs/nonnegativeInteger" },
        "notDetected": { "$ref": "#/$defs/nonnegativeInteger" },
        "researchedUnresolved": { "$ref": "#/$defs/nonnegativeInteger" },
        "notResearched": { "$ref": "#/$defs/nonnegativeInteger" },
        "researchCoveragePercent": { "$ref": "#/$defs/percentage" },
        "explicitOutcomePairs": { "$ref": "#/$defs/nonnegativeInteger" },
        "explicitOutcomeCoveragePercent": { "$ref": "#/$defs/percentage" },
        "boundedAcquisition": { "$ref": "#/$defs/boundedStatusCounts" }
      }
    },
    "sourceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "authority",
        "tier",
        "status",
        "lastRunAt",
        "evidencePairCount",
        "screenedSpeciesCount"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "tier": {
          "enum": [
            "official-national",
            "official-state",
            "academic",
            "structured-aggregator",
            "community-occurrence",
            "manual-authority",
            "legacy"
          ]
        },
        "status": { "enum": ["operational", "manual", "legacy-migration"] },
        "lastRunAt": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "evidencePairCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "screenedSpeciesCount": { "$ref": "#/$defs/nonnegativeInteger" }
      }
    },
    "queueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speciesId",
        "commonName",
        "scientificName",
        "category",
        "notResearchedCountyCount",
        "researchedUnresolvedCountyCount",
        "missingProtocolSourceIds",
        "priorityScore"
      ],
      "properties": {
        "speciesId": { "type": "string", "minLength": 1 },
        "commonName": { "type": "string", "minLength": 1 },
        "scientificName": { "type": "string", "minLength": 1 },
        "category": { "enum": ["plants", "insects", "fungi-diseases", "wildlife"] },
        "notResearchedCountyCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "researchedUnresolvedCountyCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "missingProtocolSourceIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "priorityScore": { "type": "number", "minimum": 0 }
      }
    },
    "migrationCandidates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceAssertionCount",
        "distinctPairCount",
        "reviewedSourceAssertionCount",
        "remainingSourceAssertionCount",
        "reviewedDistinctPairCount",
        "remainingDistinctPairCount"
      ],
      "properties": {
        "sourceAssertionCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "distinctPairCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "reviewedSourceAssertionCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "remainingSourceAssertionCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "reviewedDistinctPairCount": { "$ref": "#/$defs/nonnegativeInteger" },
        "remainingDistinctPairCount": { "$ref": "#/$defs/nonnegativeInteger" }
      }
    },
    "statusDefinitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified-present",
        "verified-absent",
        "not-detected",
        "researched-unresolved",
        "not-researched"
      ],
      "properties": {
        "verified-present": { "type": "string", "minLength": 1 },
        "verified-absent": { "type": "string", "minLength": 1 },
        "not-detected": { "type": "string", "minLength": 1 },
        "researched-unresolved": { "type": "string", "minLength": 1 },
        "not-researched": { "type": "string", "minLength": 1 }
      }
    },
    "questionAssessmentCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "policyId",
        "assessmentAsOf",
        "definitions",
        "pairDenominator",
        "requiredQuestionCount",
        "assessedQuestionCount",
        "supportedQuestionCount",
        "unresolvedQuestionCount",
        "questionCountCompletedWithGaps",
        "reopenedQuestionCount",
        "fullyAssessedPairCount"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "policyId": {
          "type": "string",
          "minLength": 1
        },
        "assessmentAsOf": {
          "type": "string",
          "format": "date"
        },
        "definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "required",
              "predicate",
              "period"
            ],
            "properties": {
              "id": {
                "enum": [
                  "documented-historical-occurrence",
                  "wild-occurrence-in-period",
                  "established-population-in-period",
                  "official-status-as-of"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "predicate": {
                "type": "string",
                "minLength": 1
              },
              "period": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "end": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "pairDenominator": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "requiredQuestionCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "assessedQuestionCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "supportedQuestionCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "unresolvedQuestionCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "questionCountCompletedWithGaps": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "reopenedQuestionCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "fullyAssessedPairCount": {
          "$ref": "#/$defs/nonnegativeInteger"
        }
      }
    },
    "pairQuestionAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "assessmentAsOf",
        "requiredQuestions",
        "assessedQuestions",
        "researchComplete",
        "reopenedQuestionIds",
        "answers"
      ],
      "properties": {
        "policyId": {
          "type": "string",
          "minLength": 1
        },
        "assessmentAsOf": {
          "type": "string",
          "format": "date"
        },
        "requiredQuestions": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "assessedQuestions": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "researchComplete": {
          "type": "boolean"
        },
        "reopenedQuestionIds": {
          "type": "array",
          "items": {
            "enum": [
              "documented-historical-occurrence",
              "wild-occurrence-in-period",
              "established-population-in-period",
              "official-status-as-of"
            ]
          }
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "questionId",
              "disposition",
              "answer",
              "assessmentId",
              "assessedAt",
              "explanation",
              "citations"
            ],
            "properties": {
              "questionId": {
                "enum": [
                  "documented-historical-occurrence",
                  "wild-occurrence-in-period",
                  "established-population-in-period",
                  "official-status-as-of"
                ]
              },
              "disposition": {
                "enum": [
                  "supported",
                  "assessed-unresolved",
                  "assessed-with-gaps"
                ]
              },
              "answer": {
                "anyOf": [
                  {
                    "enum": [
                      "documented-occurrence",
                      "wild-occurrence-recorded",
                      "established-population",
                      "officially-eradicated",
                      "officially-absent"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "assessmentId": {
                "type": "string",
                "minLength": 1
              },
              "assessedAt": {
                "type": "string",
                "format": "date-time"
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "evidenceId",
                    "sourceId",
                    "url",
                    "observedAt"
                  ],
                  "properties": {
                    "evidenceId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "observedAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "pairEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "sourceId",
        "sourceLabel",
        "url",
        "assertion",
        "scope",
        "caveat",
        "lineage"
      ],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "sourceLabel": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "assertion": {
          "enum": ["recorded-present", "officially-absent", "not-detected"]
        },
        "scope": {
          "enum": ["point", "survey-area", "county", "regulatory-area", "legacy-county-pair"]
        },
        "observedAt": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "minLength": 1 },
        "caveat": { "type": "string", "minLength": 1 },
        "lineage": {
          "enum": ["source-record", "source-species-county", "manual-review", "legacy-merged"]
        },
        "parentJurisdictionEvidenceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]+$"
        }
      }
    },
    "pairRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speciesId",
        "commonName",
        "scientificName",
        "category",
        "applicabilityStatus",
        "displayStatus",
        "determinationStatus",
        "surveyStatus",
        "researchStatus",
        "freshnessStatus",
        "reviewStatus",
        "conflict",
        "evidence",
        "screenedBySourceIds"
      ],
      "properties": {
        "questionAssessment": { "$ref": "#/$defs/pairQuestionAssessment" },
        "speciesId": { "type": "string", "minLength": 1 },
        "commonName": { "type": "string", "minLength": 1 },
        "scientificName": { "type": "string", "minLength": 1 },
        "category": { "enum": ["plants", "insects", "fungi-diseases", "wildlife"] },
        "applicabilityStatus": {
          "enum": ["applicable", "not-applicable", "unknown", "blocked"]
        },
        "displayStatus": {
          "enum": ["verified-present", "verified-absent", "not-detected", "researched-unresolved", "not-researched"]
        },
        "determinationStatus": { "enum": ["recorded-present", "officially-absent", "none"] },
        "historicalOccurrenceStatus": { "enum": ["recorded-present", "none"] },
        "currentDeterminationStatus": {
          "enum": ["present", "officially-eradicated", "officially-absent", "none"]
        },
        "surveyStatus": { "enum": ["detected", "not-detected", "inconclusive", "unassessed"] },
        "researchStatus": {
          "enum": [
            "resolved",
            "source-screened",
            "not-started",
            "reviewed-evidence-found",
            "reviewed-no-qualifying-evidence",
            "needs-followup",
            "blocked"
          ]
        },
        "freshnessStatus": { "enum": ["current", "aging", "stale", "undated"] },
        "reviewStatus": {
          "enum": [
            "not-reviewed",
            "machine-validated",
            "agent-reviewed",
            "human-approved",
            "rejected",
            "retracted"
          ]
        },
        "conflict": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/pairEvidence" }
        },
        "screenedBySourceIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "stateProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "stateCode",
        "stateName",
        "asOf",
        "generatedAt",
        "sourceSnapshotDate",
        "scope",
        "stateSpeciesResearch",
        "summary",
        "counties",
        "sources",
        "queue",
        "migrationCandidates",
        "statusDefinitions"
      ],
      "properties": {
        "questionAssessment": { "$ref": "#/$defs/questionAssessmentCoverage" },
        "schemaVersion": { "const": 4 },
        "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "stateName": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "sourceSnapshotDate": { "type": "string", "format": "date-time" },
        "scope": { "$ref": "#/$defs/projectionScope" },
        "stateSpeciesResearch": { "$ref": "#/$defs/stateSpeciesResolution" },
        "summary": { "$ref": "#/$defs/stateTotals" },
        "counties": {
          "type": "array",
          "items": { "$ref": "#/$defs/countySummary" },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceSummary" },
          "uniqueItems": true
        },
        "queue": {
          "type": "array",
          "items": { "$ref": "#/$defs/queueEntry" },
          "uniqueItems": true
        },
        "migrationCandidates": { "$ref": "#/$defs/migrationCandidates" },
        "statusDefinitions": { "$ref": "#/$defs/statusDefinitions" }
      }
    },
    "countyProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "stateCode",
        "countyFips",
        "countyName",
        "asOf",
        "generatedAt",
        "scope",
        "summary",
        "pairResolution",
        "pairs"
      ],
      "properties": {
        "questionAssessment": { "$ref": "#/$defs/questionAssessmentCoverage" },
        "schemaVersion": { "const": 4 },
        "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "countyFips": { "type": "string", "pattern": "^[0-9]{5}$" },
        "countyName": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "format": "date" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "scope": { "$ref": "#/$defs/projectionScope" },
        "summary": { "$ref": "#/$defs/statusCounts" },
        "pairResolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalogSpeciesPath",
            "defaultApplicability",
            "defaultDisplayStatus",
            "explicitPairCount",
            "applicabilityOverrides"
          ],
          "properties": {
            "catalogSpeciesPath": { "const": "/generated/species.json" },
            "defaultApplicability": { "const": "unknown" },
            "defaultDisplayStatus": { "const": "not-researched" },
            "explicitPairCount": { "$ref": "#/$defs/nonnegativeInteger" },
            "applicabilityOverrides": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["speciesId", "applicability"],
                "properties": {
                  "speciesId": { "type": "string", "minLength": 1 },
                  "applicability": {
                    "enum": ["applicable", "not-applicable", "unknown", "blocked"]
                  }
                }
              }
            }
          }
        },
        "pairs": {
          "type": "array",
          "items": { "$ref": "#/$defs/pairRecord" },
          "uniqueItems": true
        }
      }
    }
  }
}
