{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/state-applicability.schema.json",
  "title": "Project Isitusa explicit state species applicability",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stateCode", "asOf", "catalogSpeciesCount", "catalogSpeciesIdsSha256", "defaultDecision", "species", "undeterminedSpeciesPolicy"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "asOf": { "type": "string", "format": "date" },
    "catalogSpeciesCount": { "type": "integer", "minimum": 1 },
    "catalogSpeciesIdsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "undeterminedSpeciesPolicy": { "const": "included-as-unknown" },
    "defaultDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "note"],
      "properties": {
        "applicability": { "const": "unknown" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "species": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speciesId", "applicability", "priority", "basis"],
        "properties": {
          "speciesId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "applicability": { "enum": ["applicable", "not-applicable", "unknown", "blocked"] },
          "priority": { "enum": ["regulated", "high", "pilot", "baseline"] },
          "basis": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceId", "sourceRecordId", "url", "note"],
              "properties": {
                "sourceId": { "type": "string", "minLength": 1 },
                "sourceRecordId": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri" },
                "note": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
