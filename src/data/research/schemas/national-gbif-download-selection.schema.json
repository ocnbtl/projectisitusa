{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/national-gbif-download-selection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "selectionId", "sourceId", "planId", "baselineCommit",
    "baselineGeneratedAsOf", "selectedAt", "selectionPolicy", "acquisitionShape", "selectionThreshold",
    "counts", "credentialReadiness", "semantics", "taxa", "rankedEligibleTaxa", "candidatePairSha256", "stateScopes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "selectionId": { "type": "string", "pattern": "^round-[0-9]+-gbif-national-selection-[0-9]{8}-r[0-9]+$" },
    "sourceId": { "const": "gbif-preserved-specimens" },
    "planId": { "type": "string", "pattern": "^gbif-national-download-v2-[a-z0-9-]+$" },
    "baselineCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "baselineGeneratedAsOf": { "type": "string", "format": "date" },
    "selectedAt": { "type": "string", "format": "date-time" },
    "selectionPolicy": { "type": "string", "minLength": 1 },
    "acquisitionShape": { "type": "string", "minLength": 1 },
    "selectionThreshold": { "type": "integer", "minimum": 1, "maximum": 30000 },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["stateCount", "activeCountyCount", "taxonCount", "grossPairs", "notResearchedPairs", "blockedPairs", "alreadyResearchedPairs", "expectedNetMovement"],
      "properties": {
        "stateCount": { "const": 51 },
        "activeCountyCount": { "const": 3144 },
        "taxonCount": { "type": "integer", "minimum": 1, "maximum": 500 },
        "grossPairs": { "type": "integer", "minimum": 1 },
        "notResearchedPairs": { "type": "integer", "minimum": 1, "maximum": 30000 },
        "blockedPairs": { "type": "integer", "minimum": 0 },
        "alreadyResearchedPairs": { "type": "integer", "minimum": 0 },
        "expectedNetMovement": { "type": "integer", "minimum": 1, "maximum": 30000 }
      }
    },
    "credentialReadiness": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "requiredEnvironmentNames", "valuesPersisted"],
      "properties": {
        "status": { "const": "blocked-external-credentials-before-network" },
        "requiredEnvironmentNames": { "const": ["GBIF_USERNAME", "GBIF_PASSWORD", "GBIF_EMAIL"] },
        "valuesPersisted": { "const": false }
      }
    },
    "semantics": {
      "type": "object", "additionalProperties": false,
      "required": ["completeZeroEvidenceBecomesResearchedUnresolved", "completeAcceptedEvidenceBecomesVerifiedPresent", "createsAbsence", "createsNotDetected", "failureOrIncompleteCreatesNegative", "coordinateCountyAssignmentAllowed"],
      "properties": {
        "completeZeroEvidenceBecomesResearchedUnresolved": { "const": true },
        "completeAcceptedEvidenceBecomesVerifiedPresent": { "const": true },
        "createsAbsence": { "const": false },
        "createsNotDetected": { "const": false },
        "failureOrIncompleteCreatesNegative": { "const": false },
        "coordinateCountyAssignmentAllowed": { "const": false }
      }
    },
    "taxa": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["speciesId", "scientificName", "taxonKey", "grossPairs", "notResearchedPairs", "blockedPairs", "alreadyResearchedPairs"],
        "properties": {
          "speciesId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "scientificName": { "type": "string", "minLength": 3 },
          "taxonKey": { "type": "integer", "minimum": 1 },
          "grossPairs": { "type": "integer", "minimum": 1 },
          "notResearchedPairs": { "type": "integer", "minimum": 0 },
          "blockedPairs": { "type": "integer", "minimum": 0 },
          "alreadyResearchedPairs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "rankedEligibleTaxa": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["speciesId", "scientificName", "taxonKey", "grossPairs", "notResearchedPairs", "blockedPairs", "alreadyResearchedPairs"],
        "properties": {
          "speciesId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "scientificName": { "type": "string", "minLength": 3 },
          "taxonKey": { "type": "integer", "minimum": 1 },
          "grossPairs": { "type": "integer", "minimum": 1 },
          "notResearchedPairs": { "type": "integer", "minimum": 0 },
          "blockedPairs": { "type": "integer", "minimum": 0 },
          "alreadyResearchedPairs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "candidatePairSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stateScopes": {
      "type": "array", "minItems": 51, "maxItems": 51,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stateCode", "grossPairs", "notResearchedPairs", "blockedPairs", "alreadyResearchedPairs", "candidatePairSha256", "candidatePairs"],
        "properties": {
          "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "grossPairs": { "type": "integer", "minimum": 1 },
          "notResearchedPairs": { "type": "integer", "minimum": 0 },
          "blockedPairs": { "type": "integer", "minimum": 0 },
          "alreadyResearchedPairs": { "type": "integer", "minimum": 0 },
          "candidatePairSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "candidatePairs": {
            "type": "array", "minItems": 0, "maxItems": 30000, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]{5}:[a-z0-9-]+$" }
          }
        }
      }
    }
  }
}
