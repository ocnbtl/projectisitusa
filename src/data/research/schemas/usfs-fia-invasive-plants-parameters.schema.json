{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/usfs-fia-invasive-plants-parameters.schema.json",
  "title": "USFS FIA national invasive plant replay parameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["stateCode", "mode", "nationalAcquisitionId", "nationalAcquisitionReceiptSha256", "snapshotDate", "stateArtifactSha256", "invasiveReferenceSha256", "plantDictionarySha256", "candidateLimit", "candidatePairs"],
  "properties": {
    "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "mode": { "const": "national-snapshot-replay" },
    "nationalAcquisitionId": { "type": "string", "minLength": 1 },
    "nationalAcquisitionReceiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "snapshotDate": { "type": "string", "format": "date" },
    "stateArtifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "invasiveReferenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "plantDictionarySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateLimit": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "candidatePairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{5}:[a-z0-9-]+$" }
    }
  }
}
