{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/national-usfs-fia-reference.schema.json",
  "title": "Project Isitusa national USFS FIA partition reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "acquisitionId", "acquisitionReceiptPath", "acquisitionReceiptSha256", "snapshotDate", "sourceId", "stateCode", "stateArtifact", "invasiveReference", "plantDictionary", "adapterVersion", "adapterCodeSha256", "partitionScriptSha256", "partitionMode", "selectedRowsSha256", "mappings", "mappingReconciliation", "replayReconciliation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "acquisitionId": { "type": "string", "minLength": 1 },
    "acquisitionReceiptPath": { "type": "string", "minLength": 1 },
    "acquisitionReceiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "snapshotDate": { "type": "string", "format": "date" },
    "sourceId": { "const": "usfs-fia-invasive-plants" },
    "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "stateArtifact": { "$ref": "#/$defs/file" },
    "invasiveReference": { "$ref": "#/$defs/file" },
    "plantDictionary": { "$ref": "#/$defs/file" },
    "adapterVersion": { "enum": ["1.0.0", "1.1.0"] },
    "adapterCodeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "partitionScriptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "partitionMode": { "const": "exact-state-county-codes-and-exact-taxon-no-coordinate-fallback" },
    "selectedRowsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "speciesId", "scientificName"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1 },
          "speciesId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "scientificName": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mappingReconciliation": { "$ref": "#/$defs/counts" },
    "replayReconciliation": { "$ref": "#/$defs/counts" }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "rowCount"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "rowCount": { "type": "integer", "minimum": 0 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
