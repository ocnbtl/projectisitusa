{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/state-research-config.schema.json",
  "title": "Project Isitusa state research configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "states"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stateCode", "mode", "speciesScope", "bootstrapLedgerAllowed", "compatibilityPublication", "migrationCandidatesPath", "publicResearchProjection"],
        "properties": {
          "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "mode": { "enum": ["authoritative", "research-only"] },
          "speciesScope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "applicabilityPath", "defaultApplicability", "undeterminedSpeciesPolicy"],
            "properties": {
              "mode": { "enum": ["catalog-all", "sparse-default"] },
              "applicabilityPath": { "type": "string", "minLength": 1 },
              "defaultApplicability": { "const": "unknown" },
              "undeterminedSpeciesPolicy": { "const": "included-as-unknown" }
            }
          },
          "bootstrapLedgerAllowed": { "type": "boolean" },
          "compatibilityPublication": { "type": "boolean" },
          "migrationCandidatesPath": { "type": "string", "minLength": 1 },
          "publicResearchProjection": { "type": "boolean" }
        }
      }
    }
  }
}
