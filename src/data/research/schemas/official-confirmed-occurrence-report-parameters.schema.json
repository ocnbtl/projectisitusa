{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/official-confirmed-occurrence-report-parameters.schema.json",
  "title": "Reviewed official occurrence report parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "stateCode",
    "asOf",
    "reviewActorId",
    "records",
    "candidatePairs",
    "candidateLimit"
  ],
  "properties": {
    "mode": {
      "const": "retained-reviewed-official-occurrence"
    },
    "stateCode": {
      "const": "CA"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "reviewActorId": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recordId",
          "sha256"
        ],
        "properties": {
          "recordId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "candidatePairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{5}:[a-z0-9-]+$"
      }
    },
    "candidateLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    }
  }
}
