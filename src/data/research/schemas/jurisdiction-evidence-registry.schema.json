{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/jurisdiction-evidence-registry.schema.json",
  "title": "Project Isitusa parent jurisdiction evidence registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "dateOrNull": {
      "oneOf": [
        { "type": "string", "format": "date" },
        { "type": "null" }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "countyFips": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "url",
        "artifactPath",
        "artifactSha256",
        "supportText",
        "supportTextSha256",
        "publishedAt",
        "modifiedAt"
      ],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "artifactPath": {
          "type": "string",
          "minLength": 1
        },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "supportText": { "type": "string", "minLength": 1 },
        "supportTextSha256": { "$ref": "#/$defs/sha256" },
        "publishedAt": { "$ref": "#/$defs/dateOrNull" },
        "modifiedAt": { "$ref": "#/$defs/dateOrNull" }
      }
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "id",
        "stateCode",
        "countyFips",
        "countyFipsSha256",
        "exclusions"
      ],
      "properties": {
        "level": { "enum": ["nation", "state", "county-set"] },
        "id": { "type": "string", "minLength": 1 },
        "stateCode": {
          "oneOf": [
            { "type": "string", "pattern": "^[A-Z]{2}$" },
            { "type": "null" }
          ]
        },
        "countyFips": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/countyFips" }
        },
        "countyFipsSha256": { "$ref": "#/$defs/sha256" },
        "exclusions": {
          "type": "array",
          "maxItems": 0,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/countyFips" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "status", "actorId", "reviewedAt"],
      "properties": {
        "gate": { "const": "human-approved" },
        "status": { "const": "human-approved" },
        "actorId": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "speciesId",
        "statementType",
        "sourceDocuments",
        "jurisdiction",
        "effectiveAt",
        "reaffirmedAt",
        "validThrough",
        "review",
        "caveats"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "speciesId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "statementType": { "enum": ["officially-eradicated", "officially-absent"] },
        "sourceDocuments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceDocument" }
        },
        "jurisdiction": { "$ref": "#/$defs/jurisdiction" },
        "effectiveAt": { "type": "string", "format": "date" },
        "conflictCheckFrom": { "type": "string", "format": "date" },
        "reaffirmedAt": { "$ref": "#/$defs/dateOrNull" },
        "validThrough": { "type": "string", "format": "date" },
        "review": { "$ref": "#/$defs/review" },
        "caveats": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
