{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/eddmaps-snapshot-replay-parameters.schema.json",
  "title": "EDDMapS committed county-aggregate snapshot replay parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stateCode",
    "mode",
    "snapshotPath",
    "snapshotSha256",
    "snapshotDate",
    "citation",
    "officialUseBasisUrls",
    "targets",
    "candidatePairs"
  ],
  "properties": {
    "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "mode": { "const": "committed-snapshot-replay" },
    "snapshotPath": { "const": "src/data/source/eddmaps-snapshot.json" },
    "snapshotSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "snapshotDate": { "type": "string", "format": "date-time" },
    "citation": { "type": "string", "minLength": 1 },
    "officialUseBasisUrls": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri" }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pairKey", "countyFips", "speciesId", "scientificName", "snapshotSpeciesId", "subjectId"],
        "properties": {
          "pairKey": { "type": "string", "pattern": "^[0-9]{5}:[a-z0-9-]+$" },
          "countyFips": { "type": "string", "pattern": "^[0-9]{5}$" },
          "speciesId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "scientificName": { "type": "string", "minLength": 1 },
          "snapshotSpeciesId": { "type": "string", "minLength": 1 },
          "subjectId": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "candidatePairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{5}:[a-z0-9-]+$" }
    }
  }
}
