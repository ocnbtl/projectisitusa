{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/idigbio-preserved-specimens-parameters.schema.json",
  "title": "iDigBio preserved specimen adapter parameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["stateCode", "candidateLimit", "candidatePairs", "basisOfRecord", "country", "stateProvince", "pageLimit", "maxPagesPerSpecies", "sortField", "sortOrder"],
  "properties": {
    "stateCode": { "const": "AL" },
    "candidateLimit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "candidatePairs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{5}:[a-z0-9-]+$" }, "minItems": 1, "uniqueItems": true },
    "basisOfRecord": { "const": "preservedspecimen" },
    "country": { "const": "united states" },
    "stateProvince": { "const": "alabama" },
    "pageLimit": { "type": "integer", "minimum": 1, "maximum": 300 },
    "maxPagesPerSpecies": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "sortField": { "const": "uuid" },
    "sortOrder": { "const": "asc" }
  }
}
