          "jurisdiction": {
            "type": "object",
            "properties": {
              "level": {
                "type": "string",
                "const": "county-set"
              },
              "stateCode": {
                "type": "string",
                "enum": [
                  "IL",
                  "MA"
                ]
              },
              "countyFips": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\d{5}$"
                }
              },
              "countyFipsSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "exclusions": {
                "minItems": 0,
                "maxItems": 0,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\d{5}$"
                }
              }
