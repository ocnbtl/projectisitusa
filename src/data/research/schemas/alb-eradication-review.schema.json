  "required": [
    "schemaVersion",
    "kind",
    "evaluationId",
    "asOf",
    "status",
    "baselineCommit",
    "source",
    "baseline",
    "scope",
    "proposedParentRecords",
    "audit",
    "reconciliation",
    "boundaries"
  ],
  "additionalProperties": false
}
