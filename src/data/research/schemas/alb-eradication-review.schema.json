        "reviewedCandidatePairs",
        "eligibleNewDeterminations",
        "heldExistingPresentPairs",
        "undatedPresenceConflicts",
        "datedPostEradicationConflicts",
        "expectedPresentDeltaAfterApproval",
        "expectedAbsentDeltaAfterApproval",
        "expectedDeterminationDeltaAfterApproval",
        "actualDeterminationDeltaBeforeApproval"
      ],
      "additionalProperties": false
    },
    "boundaries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
