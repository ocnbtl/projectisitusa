      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "review-only-eradication-proposal"
    },
    "evaluationId": {
      "type": "string",
      "const": "aphis-alb-eradication-review-20260905-r2"
    },
    "asOf": {
      "type": "string",
      "const": "2026-09-05"
    },
    "status": {
      "type": "string",
      "const": "awaiting-human-approval-for-unconflicted-subset"
    },
    "baselineCommit": {
      "type": "string",
      "const": "3faf9a4efef83848610a0b7ec1a007e968dbb961"
    },
    "source": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "const": "aphis-asian-longhorned-beetle-program-update-2026"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "artifactPath": {
          "type": "string"
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifactBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "retrievedAt": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string",
          "const": "2026-07-30"
        },
        "supportText": {
          "type": "string",
          "minLength": 1
        },
        "supportTextSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "sourceId",
        "url",
        "artifactPath",
        "artifactSha256",
        "artifactBytes",
        "retrievedAt",
        "publishedAt",
        "supportText",
        "supportTextSha256"
      ],
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "properties": {
        "verifiedPresent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "verifiedAbsent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "determinations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "denominator": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "verifiedPresent",
        "verifiedAbsent",
        "determinations",
        "denominator"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "candidateCountyFips": {
          "minItems": 108,
          "maxItems": 108,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{5}$"
          }
        },
        "candidateCountyFipsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "eligibleCountyFips": {
          "minItems": 101,
          "maxItems": 101,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{5}$"
          }
        },
        "eligibleCountyFipsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "heldCountyFips": {
          "minItems": 7,
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{5}$"
          }
        },
        "heldCountyFipsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "excludedSubcountyScopes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
