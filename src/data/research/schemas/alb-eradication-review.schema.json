          "countyFips": {
            "type": "string",
            "pattern": "^\\d{5}$"
          },
          "stateCode": {
            "type": "string",
            "enum": [
              "IL",
              "MA",
              "NY"
            ]
          },
          "countyName": {
            "type": "string"
          },
          "baselineDisplayStatus": {
            "type": "string",
            "enum": [
              "verified-present",
              "researched-unresolved"
            ]
          },
          "projectionPath": {
            "type": "string"
          },
          "projectionSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "effectiveAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "conflictCheckFrom": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "presenceEvidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "evidenceId": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "observedAt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "evidenceId",
                "sourceId",
                "observedAt"
              ],
              "additionalProperties": false
            }
          },
          "conflict": {
            "type": "boolean"
          },
          "conflictReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewDisposition": {
            "type": "string",
            "enum": [
              "eligible-for-human-review",
              "held-undated-presence"
            ]
          }
        },
        "required": [
          "countyFips",
          "stateCode",
          "countyName",
          "baselineDisplayStatus",
          "projectionPath",
          "projectionSha256",
          "effectiveAt",
          "conflictCheckFrom",
          "presenceEvidence",
          "conflict",
          "conflictReason",
          "reviewDisposition"
        ],
        "additionalProperties": false
      }
