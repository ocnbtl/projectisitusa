            "additionalProperties": false
          },
          "effectiveAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "conflictCheckFrom": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "reaffirmedAt": {
            "type": "string",
            "const": "2026-07-30"
          },
          "validThrough": {
            "type": "string",
            "const": "2027-07-30"
          },
          "reviewStatus": {
            "type": "string",
            "const": "awaiting-human-approval"
          }
