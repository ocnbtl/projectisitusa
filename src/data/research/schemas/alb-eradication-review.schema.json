          "id",
          "speciesId",
          "statementType",
          "jurisdiction",
          "effectiveAt",
          "conflictCheckFrom",
          "reaffirmedAt",
          "validThrough",
          "reviewStatus"
        ],
        "additionalProperties": false
      }
