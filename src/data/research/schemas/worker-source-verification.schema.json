{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/worker-source-verification.schema.json",
  "title": "Project Isitusa worker source verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verifiedAt", "runId", "sourceId", "stateCode", "pairKeys", "parameterHash", "authority", "terms", "availability", "geography", "taxonomy", "acquisition", "negativeEvidence", "retainedEvidence", "caveats"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "runId": { "type": "string", "minLength": 1 },
    "sourceId": { "type": "string", "minLength": 1 },
    "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "pairKeys": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{5}:[a-z0-9-]+$" }, "minItems": 1, "uniqueItems": true },
    "parameterHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sourceUrl", "publisher"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "publisher": { "type": "string", "minLength": 1 }
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "termsUrl", "retentionAllowed"],
      "properties": {
        "license": { "type": "string", "minLength": 1 },
        "termsUrl": { "type": "string", "format": "uri" },
        "retentionAllowed": { "type": "boolean" }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checkedAt", "freshnessDate"],
      "properties": {
        "status": { "enum": ["available", "blocked", "unavailable", "stale"] },
        "checkedAt": { "type": "string", "format": "date-time" },
        "freshnessDate": { "type": ["string", "null"] }
      }
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "countyEquivalentSupported", "coordinatePolicy"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "countyEquivalentSupported": { "type": "boolean" },
        "coordinatePolicy": { "type": "string", "minLength": 1 }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "targetSpeciesIds"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "targetSpeciesIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotComplete", "paginationComplete", "stableIdentityFields", "requests"],
      "properties": {
        "snapshotComplete": { "type": "boolean" },
        "paginationComplete": { "type": "boolean" },
        "stableIdentityFields": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requestGroupId", "url", "purpose", "attempts", "status", "retrievedAt", "declaredRecordCount", "receivedRecordCount", "pagination"],
            "properties": {
              "requestGroupId": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" },
              "purpose": { "type": "string", "minLength": 1 },
              "attempts": { "type": "integer", "minimum": 1 },
              "status": { "type": "integer", "minimum": 100, "maximum": 599 },
              "retrievedAt": { "type": "string", "format": "date-time" },
              "declaredRecordCount": { "type": ["integer", "null"], "minimum": 0 },
              "receivedRecordCount": { "type": "integer", "minimum": 0 },
              "pagination": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "pageIndex", "offset", "limit", "cursor", "nextCursor", "endOfRecords"],
                "properties": {
                  "mode": { "enum": ["single", "offset", "cursor", "snapshot"] },
                  "pageIndex": { "type": "integer", "minimum": 0 },
                  "offset": { "type": ["integer", "null"], "minimum": 0 },
                  "limit": { "type": ["integer", "null"], "minimum": 1 },
                  "cursor": { "type": ["string", "null"] },
                  "nextCursor": { "type": ["string", "null"] },
                  "endOfRecords": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    },
    "negativeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supportsVerifiedAbsence", "supportsNotDetected", "limitations"],
      "properties": {
        "supportsVerifiedAbsence": { "type": "boolean" },
        "supportsNotDetected": { "type": "boolean" },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      }
    },
    "retainedEvidence": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "caveats": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
