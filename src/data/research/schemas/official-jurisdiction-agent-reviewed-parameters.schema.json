{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/official-jurisdiction-agent-reviewed-parameters.schema.json",
  "title": "Agent-reviewed official jurisdiction parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "stateCode",
    "parentId",
    "parentSha256",
    "asOf",
    "reviewActorId",
    "candidatePairs",
    "candidateLimit"
  ],
  "properties": {
    "mode": {
      "const": "retained-agent-reviewed-jurisdiction"
    },
    "stateCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "parentId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "parentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "reviewActorId": {
      "type": "string",
      "minLength": 1
    },
    "candidateLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "candidatePairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{5}:[a-z0-9-]+$"
      }
    }
  }
}
