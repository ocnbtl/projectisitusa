{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/question-assessment-batch.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "stateCode",
    "createdAt",
    "codeCommit",
    "methodVersion",
    "policySha256",
    "files",
    "sourceRuns"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "batchId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "stateCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "codeCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "methodVersion": {
      "type": "string",
      "minLength": 1
    },
    "policySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plans",
        "proofs",
        "assessments"
      ],
      "properties": {
        "plans": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "proofs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "assessments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "sourceRuns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runId",
          "receiptSha256"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "receiptSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
