{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/usda-nrcs-plants-parameters.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stateCode",
    "mode",
    "nationalAcquisitionId",
    "nationalAcquisitionParameterHash",
    "snapshotDate",
    "candidateLimit",
    "candidatePairs"
  ],
  "properties": {
    "stateCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "mode": {
      "const": "national-taxonomy-bounded-csv-replay"
    },
    "nationalAcquisitionId": {
      "type": "string",
      "minLength": 1
    },
    "nationalAcquisitionParameterHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshotDate": {
      "type": "string",
      "format": "date"
    },
    "candidateLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12000
    },
    "candidatePairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{5}:[a-z0-9-]+$"
      }
    }
  }
}
