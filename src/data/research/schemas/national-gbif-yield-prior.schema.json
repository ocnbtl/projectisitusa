{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/national-gbif-yield-prior.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "priorId", "generatedAt", "sourceAudit", "universe",
    "smoothing", "scopePriors", "taxonPriors", "semantics"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "priorId": { "type": "string", "pattern": "^gbif-yield-prior-rounds-[0-9-]+-[0-9]{8}-r[0-9]+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rounds", "selectedPairs", "presentPairs", "weightedYieldBps",
        "implementationPath", "implementationSha256", "resultSha256"
      ],
      "properties": {
        "rounds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "selectedPairs": { "type": "integer", "minimum": 1 },
        "presentPairs": { "type": "integer", "minimum": 0 },
        "weightedYieldBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "implementationPath": { "const": "scripts/research/audit-national-gbif-marginal-yield.ts" },
        "implementationSha256": { "$ref": "#/$defs/sha256" },
        "resultSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "planSha256", "speciesCount", "catalogPath", "catalogSha256"],
      "properties": {
        "planId": { "type": "string", "pattern": "^gbif-national-download-v1-[a-z0-9-]+$" },
        "planSha256": { "$ref": "#/$defs/sha256" },
        "speciesCount": { "type": "integer", "minimum": 1, "maximum": 500 },
        "catalogPath": { "const": "src/data/generated/species.json" },
        "catalogSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "smoothing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "globalPriorPairs", "minimumScopePairs"],
      "properties": {
        "method": { "const": "empirical-bayes-binomial-v1" },
        "globalPriorPairs": { "type": "integer", "minimum": 1 },
        "minimumScopePairs": { "type": "integer", "minimum": 1 }
      }
    },
    "scopePriors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scopePrior" }
    },
    "taxonPriors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/taxonPrior" }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planningHeuristicOnly", "guaranteesFutureYield", "createsAbsence", "createsNotDetected"],
      "properties": {
        "planningHeuristicOnly": { "const": true },
        "guaranteesFutureYield": { "const": false },
        "createsAbsence": { "const": false },
        "createsNotDetected": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "yieldScope": { "enum": ["display-group", "category", "global"] },
    "scopePrior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "key", "selectedPairs", "presentPairs", "rawYieldBps", "smoothedYieldBps"],
      "properties": {
        "scope": { "$ref": "#/$defs/yieldScope" },
        "key": { "type": "string", "minLength": 1 },
        "selectedPairs": { "type": "integer", "minimum": 0 },
        "presentPairs": { "type": "integer", "minimum": 0 },
        "rawYieldBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "smoothedYieldBps": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "taxonPrior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speciesId", "category", "displayGroup", "scope", "scopeKey",
        "observedPairs", "observedPresentPairs", "expectedPresentBps"
      ],
      "properties": {
        "speciesId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "category": { "type": "string", "minLength": 1 },
        "displayGroup": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/yieldScope" },
        "scopeKey": { "type": "string", "minLength": 1 },
        "observedPairs": { "type": "integer", "minimum": 0 },
        "observedPresentPairs": { "type": "integer", "minimum": 0 },
        "expectedPresentBps": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    }
  }
}
