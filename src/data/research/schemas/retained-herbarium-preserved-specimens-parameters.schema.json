{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/retained-herbarium-preserved-specimens-parameters.schema.json",
  "title": "Retained licensed preserved-specimen witness parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stateCode",
    "mode",
    "profile",
    "datasetUrl",
    "metadataUrl",
    "usagePolicyUrl",
    "datasetVersion",
    "publicationDate",
    "datasetLastModified",
    "datasetEtag",
    "archiveBytes",
    "archiveSha256",
    "occurrenceBytes",
    "occurrenceSha256",
    "archiveAcquiredAt",
    "preflightEvaluationId",
    "targetPairSetSha256",
    "targets",
    "candidatePairs"
  ],
  "properties": {
    "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "mode": { "const": "retained-archive-witnesses" },
    "profile": { "enum": ["nybg", "torch-brit", "smithsonian-nmnh", "harvard-huh-usa"] },
    "datasetUrl": { "type": "string", "format": "uri" },
    "metadataUrl": { "type": "string", "format": "uri" },
    "usagePolicyUrl": { "type": "string", "format": "uri" },
    "datasetVersion": { "type": "string", "minLength": 1 },
    "publicationDate": { "type": "string", "format": "date" },
    "datasetLastModified": { "type": "string", "minLength": 1 },
    "datasetEtag": { "type": ["string", "null"] },
    "archiveBytes": { "type": "integer", "minimum": 1 },
    "archiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "occurrenceBytes": { "type": "integer", "minimum": 1 },
    "occurrenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "archiveAcquiredAt": { "type": "string", "format": "date-time" },
    "preflightEvaluationId": { "type": "string", "pattern": "^(nybg|torch-brit|smithsonian-nmnh|harvard-huh-usa)-preserved-specimens-preflight-[0-9]{8}-r[0-9]+$" },
    "targetPairSetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pairKey",
          "recordId",
          "occurrenceId",
          "countyFips",
          "stateCode",
          "sourceState",
          "sourceCounty",
          "speciesId",
          "scientificName",
          "eventDate",
          "year",
          "institutionCode",
          "collectionCode",
          "catalogNumber",
          "rightsHolder",
          "references"
        ],
        "properties": {
          "pairKey": { "type": "string", "pattern": "^[0-9]{5}:[a-z0-9-]+$" },
          "recordId": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9:._{}/-]+$" },
          "occurrenceId": { "type": "string", "minLength": 20, "maxLength": 200, "pattern": "^[A-Za-z0-9:._{}/-]+$" },
          "countyFips": { "type": "string", "pattern": "^[0-9]{5}$" },
          "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "sourceState": { "type": "string", "minLength": 1 },
          "sourceCounty": { "type": "string", "minLength": 1 },
          "speciesId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "scientificName": { "type": "string", "minLength": 1 },
          "eventDate": { "type": "string", "minLength": 1 },
          "year": { "type": "integer", "minimum": 1500, "maximum": 2026 },
          "institutionCode": { "type": "string" },
          "collectionCode": { "type": "string" },
          "catalogNumber": { "type": "string" },
          "rights": { "type": "string" },
          "rightsHolder": { "type": "string" },
          "references": { "type": "string" }
        }
      }
    },
    "candidatePairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{5}:[a-z0-9-]+$" }
    }
  }
}
