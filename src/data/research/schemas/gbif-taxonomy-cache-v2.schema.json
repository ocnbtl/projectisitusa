{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/gbif-taxonomy-cache-v2.schema.json",
  "type": "object",
  "required": [
    "schemaVersion", "cacheId", "createdAt", "sourceId", "taxonomyApiVersion",
    "taxonomyMode", "checklistKey", "matcher", "acquisition", "candidatePolicy",
    "counts", "entries", "rejections"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "cacheId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "sourceId": { "const": "gbif-preserved-specimens" },
    "taxonomyApiVersion": { "const": "v2" },
    "taxonomyMode": { "const": "gbif-backbone-v2-exact-match-retained-identifiers" },
    "checklistKey": { "type": "null" },
    "matcher": { "type": "object" },
    "acquisition": { "type": "object" },
    "candidatePolicy": { "type": "object" },
    "counts": { "type": "object" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "speciesId", "scientificName", "requestUrl", "status", "retrievedAt",
          "responseBodyBase64", "responseBodySha256", "provenance"
        ]
      }
    },
    "rejections": { "type": "array" }
  }
}
