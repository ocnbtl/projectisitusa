{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/wqp-positive-parameters.schema.json",
  "title": "Versioned retained WQP positive methods",
  "oneOf": [
    {
      "title": "Reviewed retained WQP field positive counts",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "stateCode",
        "methodReviewSha256",
        "candidatePairs",
        "candidateLimit"
      ],
      "properties": {
        "mode": {
          "const": "retained-field-positive-count"
        },
        "stateCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "methodReviewSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidatePairs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{5}:(corbicula-fluminea|dreissena-polymorpha)$"
          }
        },
        "candidateLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        }
      }
    },
    {
      "title": "Reviewed retained WQP fish positive measurements",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "stateCode",
        "methodReviewSha256",
        "candidatePairs",
        "candidateLimit"
      ],
      "properties": {
        "mode": {
          "const": "retained-fish-positive-measurement"
        },
        "stateCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "methodReviewSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidatePairs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{5}:(hypophthalmichthys-molitrix|neogobius-melanostomus)$"
          }
        },
        "candidateLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        }
      }
    }
  ]
}
