{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isitusa.com/schemas/research/aphis-federal-quarantine-parameters.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["stateCode", "mode", "nationalAcquisitionId", "nationalAcquisitionParameterHash", "snapshotDate", "acceptedStatuses", "candidateLimit", "candidatePairs"],
  "properties": {
    "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "mode": { "const": "national-snapshot-replay" },
    "nationalAcquisitionId": { "type": "string", "minLength": 1 },
    "nationalAcquisitionParameterHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "snapshotDate": { "type": "string", "format": "date" },
    "acceptedStatuses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "candidateLimit": { "type": "integer", "minimum": 1, "maximum": 5000 },
    "candidatePairs": { "type": "array", "minItems": 1, "maxItems": 5000, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]{5}:[a-z0-9-]+$" } }
  }
}
