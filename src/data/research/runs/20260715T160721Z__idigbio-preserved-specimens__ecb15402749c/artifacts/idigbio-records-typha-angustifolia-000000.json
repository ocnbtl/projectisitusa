3-e1a63e0d7c6c","itemCount":8,"name":"Vanderbilt University Herbarium","description":"","logo":"https://portal.torcherbaria.org/portal/content/collicon/vdb.jpg","url":"http://www.brit.org/departments/herbarium","emllink":"https://sernecportal.org/portal/collections/datasets/emlhandler.php?collid=264","archivelink":"https://sernecportal.org/portal/content/dwca/brit-vdb_dwc-a.zip","contacts":[{"email":"hbrown@mailbox.sc.edu"},{"email":"hbrown@mailbox.sc.edu"},{"email":"herbarium@brit.org"},{"first_name":"Tiana","last_name":"Rehman","role":"Herbarium Director","email":"herbarium@brit.org"},{"first_name":"Ashley","last_name":"Bales","role":"Collections Manager","email":"abales@fwbg.org"},{"first_name":"Tiana","last_name":"Rehman","role":"Herbarium Director","email":"herbarium@brit.org"},{"first_name":"Ashley","last_name":"Bales","role":"Collections Manager","email":"abales@fwbg.org"}],"data_rights":"CC0","publisher":"42f2a0a4-5981-4874-88d5-9efb1e8d52c9","totalCount":336975,"hitRatio":0.000023740633578158616},{"uuid":"7450a9e3-ef95-4f9e-8260-09b498d2c5e6","itemCount":2,"name":"Harvard University Herbaria: All Records","description":"This dataset contains all digitized specimen records stewarded by the Harvard University Herbaria. \n\nThe Harvard University Herbaria, with over 5 million specimens, is the world’s largest University Herbaria. Included in the Herbaria are what were once six separate herbarium collections: * Herbarium of the Arnold Arboretum (A) * Economic Herbarium of Oakes Ames (ECON) * Oakes Ames Orchid Herbarium (AMES) * Farlow Herbarium (FH) * Gray Herbarium (GH) * New England Botanical Club Herbarium (NEBC).\n\nDarwinCore data follows the AppleCore guidance https://code.google.com/p/applecore/.","url":"","emllink":"https://ipt.huh.harvard.edu/ipt/eml.do?r=huh_all_records","archivelink":"https://ipt.huh.harvard.edu/ipt/archive.do?r=huh_all_records","contacts":[{"first_name":"Jonathan","last_name":"Kennedy","role":"Director of Biodiversity Informatics","email":"jonathan_kennedy@harvard.edu"},{"first_name":"Jonathan","last_name":"Kennedy","role":"Director of Biodiversity Informatics","email":"jonathan_kennedy@harvard.edu"},{"first_name":"Jonathan","last_name":"Kennedy","role":"Director of Biodiversity Informatics","email":"jonathan_kennedy@harvard.edu"},{"first_name":"Michaela","last_name":"Schmull","role":"Director of Collections","email":"mschmull@oeb.harvard.edu"},{"first_name":"Charles","last_name":"Davis","role":"Curator of Vascular Plant Collection; Professor of Organismic and Evolutionary Biology","email":"cdavis@oeb.harvard.edu"},{"first_name":"Jeannine","last_name":"Cavender-Bares","role":"Director of the Harvard University Herbaria; Professor of Organismic and Evolutionary Biology"},{"first_name":"Jonathan","last_name":"Kennedy","role":"Director of Biodiversity Informatics","email":"jonathan_kennedy@harvard.edu"}],"data_rights":"CC4 BY","publisher":"a8dbdab2-4e17-47d4-b051-d37552bf2396","totalCount":2048583,"hitRatio":9.76284583050821e-7},{"uuid":"215eeaf0-0a88-409e-a75d-aec98b7c41eb","itemCount":1,"name":"Intermountain Herbarium (Vasc. & Algae)","description":"Records in this database are of the vascular plants and algae (of which there are very few) in the Intermountain Herbarium. Records for fungi, lichens and bryophytes are now being posted to the taxon-specific networks. The geographic focus of the Intermountain Herbarium is the Intermountain Region of western North America but its holdings come from many different countries. It even has one or more specimens from each of the seven continents. The collection is particularly rich in the Scrophulariaceae (traditional sense), Eriogonum, and grasses, including voucher specimens of plants used by the late D.R. Dewey in his cytogenetic studies of the Triticeae.","logo":"https://swbiodiversity.org/seinet/content/collicon/utc.jpg","url":"http://herbarium.usu.edu/default.htm","emllink":"https://sernecportal.org/portal/collections/datasets/emlhandler.php?collid=16","archivelink":"https://intermountainbiota.org/portal/content/dwca/usu-utc_dwc-a.zip","contacts":[{"email":"hbrown@mailbox.sc.edu"},{"email":"hbrown@mailbox.sc.edu"},{"email":"kristian.valles@usu.edu"},{"first_name":"Kristian","last_name":"Valles","role":"Associate Curator","email":"kristian.valles@usu.edu"},{"first_name":"Kristian","last_name":"Valles","role":"Associate Curator","email":"kristian.valles@usu.edu"}],"data_rights":"CC0","publisher":"2daea127-0e40-4756-9762-cdaf0bd78166","totalCount":192109,"hitRatio":0.000005205378196752885},{"uuid":"264c48ec-8636-451f-a7e0-74131bc6f84c","itemCount":1,"name":"Clemson University Herbarium","description":"","logo":"https://sernecportal.org/portal/content/collicon/clems.gif","url":"https://www.clemson.edu/science/academics/departments/biosci/outreach/museum.html","emllink":"https://sernecportal.org/portal/collections/datasets/emlhandler.php?collid=155","archivelink":"https://sernecportal.org/portal/content/dwca/clems_dwc-a.zip","contacts":[{"email":"hbrown@mailbox.sc.edu"},{"email":"hbrown@mailbox.sc.edu"},{"email":"ddamrel@clemson.edu"},{"first_name":"Dia Z.","last_name":"Damrel","email":"ddamrel@clemson.edu"},{"first_name":"Lorena","last_name":"Endara","role":"Curator","email":"cendara@clemson.edu"},{"first_name":"Dia Z.","last_name":"Damrel","email":"ddamrel@clemson.edu"},{"first_name":"Lorena","last_name":"Endara","role":"Curator","email":"cendara@clemson.edu"}],"data_rights":"CC3 BY-NC","publisher":"42f2a0a4-5981-4874-88d5-9efb1e8d52c9","totalCount":84423,"hitRatio":0.0000118451132985087},{"uuid":"733616a3-f5f6-4b65-b62e-fe8892e75bdf","itemCount":1,"name":"Brigham Young University Herbarium","description":"Vascular Plants. Curator: Leigh Johnson. The herbarium has completed databasing the non-seed vascular plants, gymnosperms, and monocots with the exception of grasses. We are working though the dicots alphabetically by family, and have a scattering of other material completed. Some records that are incomplete, duplicate sheets, or that otherwise need additional attention may not be uploaded for searching here.\r\nAs of Fall 2025, we are accelerating web-access to specimens by prioritizing and uploading base-line data (taxon, collector &amp; number, date, and primary geographic political units) linked to images from which complete label data can be viewed. Complete transcript will proceed over time.The herbarium at BYU is recognized by the Index Herbariorum acronym 'BRY'. 'V' indicates the vascular plant portion of BRY. The vascular plant herbarium also houses a smaller collection gifted to Brigham Young University from the Ogden Forest Service, which maintains its Index Herbariorum acronym 'OGDF'. BRY additionally encompasses the Herbarium of Non-Vascular Cryptogams (including lichenized fungi), which is administered independently with its own database, catalog numbers, and portal. The non-vascular cryptograms &amp; lichens are curated by Steven Leavitt. Information made available here electronically, including specimen data and images, has been produced by support from Brigham Young University, NSF grants DBI&ndash;1203616 &amp; 2448892, the Grand Canyon Trust, and a Utah-BLM Challenge Cost-Share agreement. Any opinions, findings, and conclusions or recommendations expressed in this material are those of our herbarium and do not necessarily reflect the views of the National Science Foundation or other supporting agencies. Please acknowledge BRY in publications or products that have benefitted from the use of these data.","logo":"https://swbiodiversity.org/seinet/content/collicon/bry.gif","url":"https://lsm.byu.edu/research-collections","emllink":"https://intermountainbiota.org/portal/content/dwca/bry-v_dwc-a.eml","archivelink":"https://intermountainbiota.org/portal/content/dwca/bry-v_dwc-a.zip","contacts":[{"email":"Mary.Barkworth@usu.edu"},{"email":"Mary.Barkworth@usu.edu"},{"email":"leigh_johnson@byu.edu"},{"first_name":"Leigh","last_name":"Johnson","role":"Curator","email":"leigh_johnson@byu.edu"},{"first_name":"Leigh","last_name":"Johnson","role":"Curator","email":"leigh_johnson@byu.edu"}],"data_rights":"CC4 BY-NC","publisher":"2daea127-0e40-4756-9762-cdaf0bd78166","totalCount":345642,"hitRatio":0.0000028931669183721886},{"uuid":"beab5209-9628-4d4d-851e-2bc9bb1a0105","itemCount":1,"name":"University of Georgia Herbarium","description":"","logo":"https://sernecportal.org/portal/content/collicon/ga_new.jpg","url":"https://www.plantbio.uga.edu/uga-herbarium","emllink":"https://sernecportal.org/portal/collections/datasets/emlhandler.php?collid=258","archivelink":"https://sernecportal.org/portal/content/dwca/ga_dwc-a.zip","contacts":[{"email":"hbrown@mailbox.sc.edu"},{"email":"hbrown@mailbox.sc.edu"},{"email":"tanisha.williams1@uga.edu"},{"first_name":"Tanisha","last_name":"Williams","role":"Curator/Director","email":"tanisha.williams1@uga.edu"},{"first_name":"Steven","last_name":"Hughes","role":"Collections Manager","email":"sthughes@uga.edu"},{"first_name":"Tanisha","last_name":"Williams","role":"Curator/Director","email":"tanisha.williams1@uga.edu"},{"first_name":"Steven","last_name":"Hughes","role":"Collections Manager","email":"sthughes@uga.edu"}],"data_rights":"CC4 BY-NC","publisher":"42f2a0a4-5981-4874-88d5-9efb1e8d52c9","totalCount":280846,"hitRatio":0.0000035606702605698496},{"uuid":"e36691ec-c4f8-4bec-b331-b48ffa82ff49","itemCount":1,"name":"UTEP Plants (Arctos)","description":"The Herbarium contains well over 82,000 catalogued plant specimens. Overall geographic content of the Herbarium is approximately as follows: Texas, 24%; New Mexico, 22%; other USA, 32%; Mexico, 7%; other world, 15%. Herbarium materials at UTEP that are of special interest include an extensive representation of the floras of the desert mountain ranges of southern New Mexico and western Texas partially from a thorough floral survey and inventory across an east-west transect running from the Guadalupe/Davis Mountains of Texas to the Chiricahua Mountains of Arizona; voucher samples of specimens from which nectar samples were collected for the nectar chemistry research of C. E. Freeman and W. H. Reid; a seed collection, representing more than 800 species of mostly Southwestern taxa with individual samples mounted on slides and cross-indexed to their source sheets in the main herbarium collection; a cryptogamic collection in excess of 650 specimens, predominately lichens and mosses from various areas in southwestern North America, with significant collections of local specimens used for baseline data in studies by R. D. Worthington and his students on air pollution effects in the El Paso/Ciudad Juarez area; a synoptic collection from White Sands National Monument, representing survey work performed by W. H. Reid during the early 1970's.","url":"http://www.utep.edu/biodiversity/collections/herbarium.html https://ipt.vertnet.org/archive.do?r=utep_herb","emllink":"https://ipt.vertnet.org/eml.do?r=utep_herb","archivelink":"https://ipt.vertnet.org/archive.do?r=utep_herb","contacts":[{"first_name":"Teresa","last_name":"Mayfield-Meyer","role":"Collection Data Volunteer, UTEP Biodiversity Collections","email":"tmayfield.utepbc@jegelewicz.net"},{"first_name":"Vicky","last_name":"Zhuang","role":"Manager, UTEP Biodiversity Collections","email":"mzhuang@utep.edu"},{"first_name":"Teresa","last_name":"Mayfield-Meyer","role":"Collection Data Volunteer, UTEP Biodiversity Collections","email":"tmayfield.utepbc@jegelewicz.net"},{"first_name":"Vicky","last_name":"Zhuang","role":"Manager, UTEP Biodiversity Collections","email":"mzhuang@utep.edu"},{"first_name":"David","last_name":"Bloom","role":"Coordinator","email":"dbloom@vertnet.org"},{"first_name":"Dusty","last_name":"McDonald","role":"Arctos Database Programmer","email":"dlmcdonald@alaska.edu"},{"first_name":"Vicky","last_name":"Zhuang","role":"Manager, UTEP Biodiversity Collections","email":"mzhuang@utep.edu"},{"first_name":"Teresa","last_name":"Mayfield-Meyer","role":"Collection Data Volunteer, UTEP Biodiversity Collections","email":"tmayfield.utepbc@jegelewicz.net"},{"first_name":"Richard","last_name":"Worthington","role":"Curator, UTEP Biodiversity Collections Herbarium","email":"rworthin@utep.edu"}],"data_rights":"CC0","publisher":"842a2bb5-d705-4d6c-8401-abf3ca28c05d","totalCount":83403,"hitRatio":0.000011989976379746532},{"uuid":"f1cf8457-237e-487a-9d13-5de7d81b9de4","itemCount":1,"name":"University of South Florida Herbarium (USF)","description":"The USF Herbarium was established as a research and teaching collection in 1958 by George R. Cooley, two years after the founding of the University of South Florida. The USF Herbarium is the second largest collection in Florida, the seventh largest in the southeastern United States, and ranks in the upper third of the world's herbaria in size. The herbarium contains approximately 280,000 specimens, consisting of about 260,000 specimens of vascular plants, 14,000 algae, 2,800 bryophytes, 1,300 lichens, and 300 macrofungi. The collection contains approximately 400 type specimens. The herbarium is richest in specimens from Florida (~40%), with additional holdings from North America north of Mexico (~35%), Latin America and the West Indies (~15%), and the Eastern Hemisphere (~10%). Specific groups well represented in the herbarium include Acanthaceae, Apocynaceae, Begoniaceae, Bromeliaceae, Fabaceae, Orchidaceae, and pteridophytes (ferns).","logo":"https://cdn.plantatlas.org/img/logos/usf-v-black.jpg","url":"http://biology.usf.edu/cmmb/research/herbarium/","emllink":"https://ipt.plantatlas.usf.edu/eml.do?r=usf_herb","archivelink":"https://ipt.plantatlas.usf.edu/archive.do?r=usf_herb","contacts":[{"first_name":"Alan R.","last_name":"Franck","role":"Curator","email":"afranck@mail.usf.edu"},{"first_name":"Alan R.","last_name":"Franck","role":"Curator","email":"afranck@mail.usf.edu"},{"first_name":"Keith","last_name":"Bornhorst","role":"IT","email":"bornhorst@usf.edu"},{"first_name":"Bruce F.","last_name":"Hansen","role":"Associated Research Staff","email":"hansen@usf.edu"},{"first_name":"Alan R.","last_name":"Franck","role":"Curator","email":"afranck@mail.usf.edu"}],"data_rights":"CC4 BY","publisher":"ce4b086a-5805-4edf-8044-4593f62f4790","totalCount":240829,"hitRatio":0.0000041523238480415564}],"aggs":{"rs":{"doc_count_error_upper_bound":0,"sum_other_doc_count":0,"buckets":[{"key":"72d4c3c7-3413-4588-a803-e1a63e0d7c6c","doc_count":8},{"key":"7450a9e3-ef95-4f9e-8260-09b498d2c5e6","doc_count":2},{"key":"215eeaf0-0a88-409e-a75d-aec98b7c41eb","doc_count":1},{"key":"264c48ec-8636-451f-a7e0-74131bc6f84c","doc_count":1},{"key":"733616a3-f5f6-4b65-b62e-fe8892e75bdf","doc_count":1},{"key":"beab5209-9628-4d4d-851e-2bc9bb1a0105","doc_count":1},{"key":"e36691ec-c4f8-4bec-b331-b48ffa82ff49","doc_count":1},{"key":"f1cf8457-237e-487a-9d13-5de7d81b9de4","doc_count":1}]},"unique_scientific_names":{"doc_count_error_upper_bound":0,"sum_other_doc_count":0,"buckets":[{"key":"typha angustifolia","doc_count":16}]},"max_dm":{"value":1776962892130,"value_as_string":"2026-04-23T16:48:12.130Z"}}}