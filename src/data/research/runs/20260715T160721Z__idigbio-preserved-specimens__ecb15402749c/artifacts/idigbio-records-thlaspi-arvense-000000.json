981-4874-88d5-9efb1e8d52c9","totalCount":336975,"hitRatio":0.00000890273759180948},{"uuid":"e60301d9-9b40-483f-92de-065769b9d3dd","itemCount":2,"name":"University of Louisiana at Monroe Herbarium, R. Dale Thomas Collection","description":"The R. Dale Thomas Collection - University of Louisiana Monroe (NLU) collection was transferred to the Botanical Research Institute of Texas in 2017. Additionally in 2018-2019, more than 50,000 NLU specimens were transferred to the Shirley C. Tucker Herbarium (LSU) at Lousiana State University. Please contact Tiana Rehman (trehman@brit.org) with any questions regarding the collection.","logo":"https://sernecportal.org/portal/content/collicon/nlu.png","url":"http://www.brit.org/research/collections/nlu","emllink":"https://sernecportal.org/portal/collections/datasets/emlhandler.php?collid=309","archivelink":"https://sernecportal.org/portal/content/dwca/brit-nlu_dwc-a.zip","contacts":[{"email":"hbrown@mailbox.sc.edu"},{"email":"hbrown@mailbox.sc.edu"},{"email":"trehman@brit.org"},{"first_name":"Tiana","last_name":"Rehman","role":"Herbarium Director","email":"trehman@brit.org"},{"first_name":"Ashley","last_name":"Bales","role":"Collections Manager","email":"abales@fwbg.org"},{"first_name":"Tiana","last_name":"Rehman","role":"Herbarium Director","email":"trehman@brit.org"},{"first_name":"Ashley","last_name":"Bales","role":"Collections Manager","email":"abales@fwbg.org"}],"data_rights":"CC0","publisher":"42f2a0a4-5981-4874-88d5-9efb1e8d52c9","totalCount":384591,"hitRatio":0.000005200329700903038},{"uuid":"5e29dbcc-ce45-4f05-9bb0-212baffa8932","itemCount":1,"name":"University of Mississippi, Thomas M. Pullen Herbarium","description":"The Pullen Herbarium (MISS) collection is located on the campus of the University of Mississippi in Oxford, MS, and consists of over 80,000 vascular plant specimens, as well as non vascular plants, slime molds and macrofungi.&nbsp; With funding from the National Science Foundation, the collection is housed in a compactor system and the specimen data and images have been digitized.&nbsp; Vascular plant specimens can be searched on SERNEC and macrofungi are displayed in MycoPortal.","logo":"https://sernecportal.org/portal/content/collicon/miss.png","url":"http://www.herbarium.olemiss.edu/","emllink":"https://sernecportal.org/portal/collections/datasets/emlhandler.php?collid=220","archivelink":"https://sernecportal.org/portal/content/dwca/miss_dwc-a.zip","contacts":[{"email":"hbrown@mailbox.sc.edu"},{"email":"hbrown@mailbox.sc.edu"},{"email":"bymccook@olemiss.edu"},{"last_name":"Lucile McCook, Curator","email":"bymccook@olemiss.edu"},{"last_name":"Lucile McCook, Curator","email":"bymccook@olemiss.edu"}],"data_rights":"CC3 BY-NC","publisher":"42f2a0a4-5981-4874-88d5-9efb1e8d52c9","totalCount":80667,"hitRatio":0.000012396642989078557},{"uuid":"7450a9e3-ef95-4f9e-8260-09b498d2c5e6","itemCount":1,"name":"Harvard University Herbaria: All Records","description":"This dataset contains all digitized specimen records stewarded by the Harvard University Herbaria. \n\nThe Harvard University Herbaria, with over 5 million specimens, is the world’s largest University Herbaria. Included in the Herbaria are what were once six separate herbarium collections: * Herbarium of the Arnold Arboretum (A) * Economic Herbarium of Oakes Ames (ECON) * Oakes Ames Orchid Herbarium (AMES) * Farlow Herbarium (FH) * Gray Herbarium (GH) * New England Botanical Club Herbarium (NEBC).\n\nDarwinCore data follows the AppleCore guidance https://code.google.com/p/applecore/.","url":"","emllink":"https://ipt.huh.harvard.edu/ipt/eml.do?r=huh_all_records","archivelink":"https://ipt.huh.harvard.edu/ipt/archive.do?r=huh_all_records","contacts":[{"first_name":"Jonathan","last_name":"Kennedy","role":"Director of Biodiversity Informatics","email":"jonathan_kennedy@harvard.edu"},{"first_name":"Jonathan","last_name":"Kennedy","role":"Director of Biodiversity Informatics","email":"jonathan_kennedy@harvard.edu"},{"first_nam