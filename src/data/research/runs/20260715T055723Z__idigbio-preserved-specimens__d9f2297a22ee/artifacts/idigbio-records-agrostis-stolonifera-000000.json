s":[{"email":"hbrown@mailbox.sc.edu"},{"email":"hbrown@mailbox.sc.edu"},{"email":"tanisha.williams1@uga.edu"},{"first_name":"Tanisha","last_name":"Williams","role":"Curator/Director","email":"tanisha.williams1@uga.edu"},{"first_name":"Steven","last_name":"Hughes","role":"Collections Manager","email":"sthughes@uga.edu"},{"first_name":"Tanisha","last_name":"Williams","role":"Curator/Director","email":"tanisha.williams1@uga.edu"},{"first_name":"Steven","last_name":"Hughes","role":"Collections Manager","email":"sthughes@uga.edu"}],"data_rights":"CC4 BY-NC","publisher":"42f2a0a4-5981-4874-88d5-9efb1e8d52c9","totalCount":280846,"hitRatio":0.000007121340521139699},{"uuid":"36d35b23-113e-4633-90ec-19d265a3b5f6","itemCount":1,"name":"The New York Botanical Garden Herbarium (NY)","description":"The William and Lynda Steere Herbarium of The New York Botanical Garden holds a collection of more than seven million preserved specimens. All plant groups – flowering plants, conifers, ferns, mosses, liverworts, and algae, as well as fungi and lichens - are represented in the collection, which is particularly strong in specimens from the Western Hemisphere. Digitization of all groups is ongoing, with ±4.7 million specimens barcoded and ±3.8 million imaged.","logo":"https://sweetgum.nybg.org/science/wp-content/themes/nybgscience/images/logo23.svg","url":"https://sweetgum.nybg.org/science/vh/","emllink":"https://sweetgum.nybg.org:8443/ipt/eml.do?r=occurrences","archivelink":"https://sweetgum.nybg.org:8443/ipt/archive.do?r=occurrences","contacts":[{"first_name":"Joel","last_name":"Ramirez","role":"Web Developer for Biodiversity Information Management","email":"jramirez@nybg.org"},{"first_name":"Kimberly","last_name":"Watson","role":"Assistant Director of Biodiversity Information Management","email":"kwatson@nybg.org"},{"first_name":"Leanna","last_name":"Feder","role":"Herbarium Digital Asset Manager","email":"lfeder@nybg.org"},{"first_name":"Elizabeth","last_name":"Gjieli","role":"Geographical Information Manager","email":"egjieli@nybg.org"},{"first_name":"Emily","last_name":"Sessa","role":"Director of the Herbarium","email":"esessa@nybg.org"},{"first_name":"Kimberly","last_name":"Watson","email":"kwatson@nybg.org"},{"first_name":"Kimberly","last_name":"Watson","role":"Assistant Director of Biodiversity Information Management","email":"kwatson@nybg.org"}],"data_rights":"CC0","publisher":"e84b1163-233d-4e46-9eb8-aa2d0d3ff7d8","totalCount":4808642,"hitRatio":2.0795892062665508e-7},{"uuid":"5386d272-06c6-4027-b5d5-d588c2afe5e5","itemCount":1,"name":"Tropicos MO Specimen Data","description":"The Missouri Botanical Garden’s Herbarium is one of the world’s outstanding research resources for specimens and information on bryophytes and vascular plants. The collection is limited to these two major groups of plants. As of 31 December 2020 the herbarium collection had 6.93 million mounted specimens (6.33 million vascular plants and 598,000 bryophytes). This specimen dataset includes over 4.7 million records (4.3 million vascular plants and 380,000 bryophytes).","url":"","emllink":"http://ipt.mobot.org:8080/ipt/eml.do?r=tropicosspecimens","archivelink":"http://ipt.mobot.org:8080/ipt/archive.do?r=tropicosspecimens","contacts":[{"first_name":"Jordan","last_name":"Teisher","role":"Curator and Director of the Herbarium","email":"jteisher@mobot.org"},{"first_name":"Heather","last_name":"Stimmel","role":"Programmer Analyst","email":"heather.stimmel@mobot.org"},{"first_name":"Heather","last_name":"Stimmel","email":"heather.stimmel@mobot.org"},{"first_name":"Jordan","last_name":"Teisher","role":"Curator and Director of the Herbarium","email":"jteisher@mobot.org"}],"data_rights":"CC4 BY","publisher":"eaa701aa-2b56-4058-bbe7-c0bea9c1661d","totalCount":4496509,"hitRatio":2.2239475112804179e-7},{"uuid":"8ec76c75-a673-4682-bfde-00a18bc12794","itemCount":1,"name":"San Juan College Herbarium","description":"Specialty: Vascular flora of Four Corners area, San Juan Drainage; Fabaceae; Polygonaceae; Cactaceae; Orchidaceae; Cyperaceae.","logo":"https://swbiodiversity.org/seinet/content/collicon/sjnm.png","url":"https://www.sanjuancollege.edu/science-math-and-engineering/herbarium/","emllink":"https://sernecportal.org/portal/collections/datasets/emlhandler.php?collid=104","archivelink":"https://swbiodiversity.org/seinet/content/dwca/sjnm_dwc-a.zip","contacts":[{"email":"hbrown@mailbox.sc.edu"},{"email":"hbrown@mailbox.sc.edu"},{"email":"loneyd@sanjuancollege.edu"},{"first_name":"David","last_name":"Loney","role":"Director","email":"loneyd@sanjuancollege.edu"},{"first_name":"John","last_name":"Reese","role":"Biology Faculty","email":"reesejo@sanjuancollege.edu"},{"first_name":"David","last_name":"Loney","role":"Director","email":"loneyd@sanjuancollege.edu"},{"first_name":"John","last_name":"Reese","role":"Biology Faculty","email":"reesejo@sanjuancollege.edu"}],"data_rights":"CC3 BY-NC","publisher":"a9dfa037-425b-442b-8974-94487c29114e","totalCount":75489,"hitRatio":0.000013246963133701599},{"uuid":"d53132e6-7997-4850-8607-4fec5a3f9c3f","itemCount":1,"name":"University of Tennessee Vascular Herbarium","description":"The TENN vascular collection has a strong emphasis on widespread and/or temperate taxa. Even though the collection houses representative specimens of the world's flora, it is unique in having the largest collection of specimens from the state of Tennessee, the historical collections documenting the flora of the Great Smoky Mountains National Park (a World Biosphere Reserve), and the large, general collection from throughout the southern Appalachians. Significant and representative collections are also present from the remainder of the U. S., including Alaska, Central and South America, and Afro-Eurasia. The pteridophyte collection is more cosmopolitan than the rest of the vascular plant collection due, in large part, to the collecting and exchange of A. M. Evans and A. J. Sharp.","logo":"https://swbiodiversity.org/seinet/content/c