":"","logo":"https://sernecportal.org/portal/content/collicon/ga_new.jpg","url":"https://www.plantbio.uga.edu/uga-herbarium","emllink":"https://sernecportal.org/portal/collections/datasets/emlhandler.php?collid=258","archivelink":"https://sernecportal.org/portal/content/dwca/ga_dwc-a.zip","contacts":[{"email":"hbrown@mailbox.sc.edu"},{"email":"hbrown@mailbox.sc.edu"},{"email":"tanisha.williams1@uga.edu"},{"first_name":"Tanisha","last_name":"Williams","role":"Curator/Director","email":"tanisha.williams1@uga.edu"},{"first_name":"Steven","last_name":"Hughes","role":"Collections Manager","email":"sthughes@uga.edu"},{"first_name":"Tanisha","last_name":"Williams","role":"Curator/Director","email":"tanisha.williams1@uga.edu"},{"first_name":"Steven","last_name":"Hughes","role":"Collections Manager","email":"sthughes@uga.edu"}],"data_rights":"CC4 BY-NC","publisher":"42f2a0a4-5981-4874-88d5-9efb1e8d52c9","totalCount":280846,"hitRatio":0.0000035606702605698496},{"uuid":"ddef79ec-043c-4027-9876-c4a298feff6d","itemCount":1,"name":"Florida State University, Robert K. Godfrey Herbarium","description":"The collection contains >220,000 specimens that document the distribution and natural variation of plants and algae worldwide, with a special focus on the 2,400 species of plants found in N FL--one of North America's biodiversity hotspots--and the microalgae of Florida's Gulf and Atlantic coasts.","logo":"https://sernecportal.org/portal/content/collicon/fsu.png","url":"http://herbarium.bio.fsu.edu/","emllink":"https://sernecportal.org/portal/content/dwca/fsu_dwc-a.eml","archivelink":"https://sernecportal.org/portal/content/dwca/fsu_dwc-a.zip","contacts":[{"email":"hbrown@mailbox.sc.edu"},{"email":"hbrown@mailbox.sc.edu"},{"email":"amast@bio.fsu.edu"},{"last_name":"Dr. Austin R. Mast","email":"amast@bio.fsu.edu"},{"last_name":"Dr. Austin R. Mast","email":"amast@bio.fsu.edu"}],"data_rights":"CC3 BY-NC","publisher":"42f2a0a4-5981-4874-88d5-9efb1e8d52c9","totalCount":85749,"hitRatio":0.000011661943579516963},{"uuid":"e36691ec-c4f8-4bec-b331-b48ffa82ff49","itemCount":1,"name":"UTEP Plants (Arctos)","description":"The Herbarium contains well over 82,000 catalogued plant specimens. Overall geographic content of the Herbarium is approximately as follows: Texas, 24%; New Mexico, 22%; other USA, 32%; Mexico, 7%; other world, 15%. Herbarium materials at UTEP that are of special interest include an extensive representation of the floras of the desert mountain ranges of southern New Mexico and western Texas partially from a thorough floral survey and inventory across an east-west transect running from the Guadalupe/Davis Mountains of Texas to the Chiricahua Mountains of Arizona; voucher samples of specimens from which nectar samples were collected for the nectar chemistry research of C. E. Freeman and W. H. Reid; a seed collection, representing more than 800 species of mostly Southwestern taxa with individual samples mounted on slides and cross-indexed to their source sheets in the main herbarium collection; a cryptogamic collection in excess of 650 specimens, predominately lichens and mosses from various areas in southwestern North America, with significant collections of local specimens used for baseline data in studies by R. D. Worthington and his students on air pollution effects in the El Paso/Ciudad Juarez area; a synoptic collection from White Sands National Monument, representing survey work performed by W. H. Reid during the early 1970's.","url":"http://www.utep.edu/biodiversity/collections/herbarium.html https://ipt.vertnet.org/archive.do?r=utep_herb","emllink":"https://ipt.vertnet.org/eml.do?r=utep_herb","archivelink":"https://ipt.vertnet.org/archive.do?r=utep_herb","contacts":[{"first_name":"Teresa","last_name":"Mayfield-Meyer","role":"Collection Data Volunteer, UTEP Biodiversity Collections","email":"tmayfield.utepbc@jegelewicz.net"},{"first_name":"Vicky","last_name":"Zhuang","role":"Manager, UTEP Biodiversity Collections","email":"mzhuang@utep.edu"},{"first_name":"Teresa","last_name":"Mayfield-Meyer","role":"Collection Data Volunteer, UTEP Biodiversity Collections","email":"tmayfield.utepbc@jegelewicz.net"},{"first_name":"Vicky","last_name":"Zhuang","role":"Manager, UTEP Biodiversity Collections","email":"mzhuang@utep.edu"},{"first_name":"David","last_name":"Bloom","role":"Coordinator","email":"dbloom@vertnet.org"},{"first_name":"Dusty","last_name":"McDonald","role":"Arctos Database Programmer","email":"dlmcdonald@alaska.edu"},{"first_name":"Vicky","last_name":"Zhuang","role":"Manager, UTEP Biodiversity Collections","email":"mzhuang@utep.edu"},{"first_name":"Teresa","last_name":"Mayfield-Meyer","role":"Collection Data Volunteer, UTEP Biodiversity Collections","email":"tmayfield.utepbc@jegelewicz.net"},{"first_name":"Richard","last_name":"Worthington","role":"Curator, UTEP Biodiversity Collections Herbarium","email":"rworthin@utep.edu"}],"data_rights":"CC0","publisher":"842a2bb5-d705-4d6c-8401-abf3ca28c05d","totalCount":83403,"hitRatio":0.000011989976379746532}],"aggs":{"rs":{"doc_count_error_upper_bound":0,"sum_other_doc_count":0,"buckets":[{"key":"23a47a5f-2ac1-4f81-acd3-21d5b82ed22a","doc_count":1},{"key":"471835cc-feb6-4d05-a8d1-62ce71399326","doc_count":1},{"key":"6258d160-a7aa-4937-bce3-3538eebd374f","doc_count":1},{"key":"72d4c3c7-3413-4588-a803-e1a63e0d7c6c","doc_count":1},{"key":"a6eee223-cf3b-4079-8bb2-b77dad8cae9d","doc_count":1},{"key":"ad4e4ea0-2ac9-4030-b4bd-bf4206e79bcc","doc_count":1},{"key":"beab5209-9628-4d4d-851e-2bc9bb1a0105","doc_count":1},{"key":"ddef79ec-043c-4027-9876-c4a298feff6d","doc_count":1},{"key":"e36691ec-c4f8-4bec-b331-b48ffa82ff49","doc_count":1}]},"unique_scientific_names":{"doc_count_error_upper_bound":0,"sum_other_doc_count":0,"buckets":[{"key":"veronica serpyllifolia","doc_count":9}]},"max_dm":{"value":1776962892130,"value_as_string":"2026-04-23T16:48:12.130Z"}}}